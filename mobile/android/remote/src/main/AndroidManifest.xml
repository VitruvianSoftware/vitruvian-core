<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET reaches the Mac agent over Tailscale; ACCESS_NETWORK_STATE
      backs the unreachable banner; the wake-on-LAN magic packet needs
      multicast on the local segment. Nothing here is granted for the mock
      data - they are the permissions the real transport needs.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Bluetooth HID: the phone presents itself to macOS as a keyboard, which is
      how the remote drives the Mac with nothing installed on the Mac. Same
      trick the esp32-s3 board uses.

      BLUETOOTH_CONNECT is runtime-requested from API 31; the two legacy
      permissions below cover 26-30, where it does not exist. usesPermissionFlags
      on neverForLocation is not needed: we never scan, the Mac connects to US.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
      Phone-local notifications: the Mac going quiet, and a command that
      finished while the app was in the background. Runtime-requested from
      API 33 the same way BLUETOOTH_CONNECT is, after the first frame.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The phone bridge (v1.3, docs/phone-bridge.md): agents on the Mac get an
      MCP server whose tools run here. Each permission below is one tool, and a
      tool whose permission is missing returns the sentence that names the
      Grant button rather than an empty list.

      READ_SMS        - sms.list, the last n received messages
      SEND_SMS        - sms.send; outbound tier, so it needs an Approve tap or
                        the trust window before it ever runs
      READ_CONTACTS   - contacts.search, so an agent can turn "text Sam" into a
                        number without the number being in the prompt
      READ_CALL_LOG   - calls.log
      CALL_PHONE      - calls.dial; outbound tier, same gate as SEND_SMS
      ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION
                      - location.current. Both are declared because a phone
                        that grants only the coarse one still answers, with a
                        worse accuracy figure that the tool reports honestly;
                        asking for fine alone would make "Approximate" a silent
                        refusal.

      All six are runtime permissions, granted one row at a time from the Phone
      bridge plate on the Hosts screen. None is requested at startup: the app
      is a Mac remote first; a fresh install that asks for the SMS
      permission before it has drawn a frame is an app nobody grants anything.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      The bridge's link is a socket held open while the phone is in a pocket,
      which is exactly what a foreground service is for. FOREGROUND_SERVICE has
      been required since API 28; from API 34 the type must be declared as its
      own permission too, and a mismatch between this and the service's
      android:foregroundServiceType is a SecurityException at start rather than
      a warning.

      dataSync is the honest type: a long-lived transfer with the user's own
      machine. The notification it obliges us to show is the feature: it says
      whether the link is up, how long agents stay trusted, and carries Stop.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      Dictation runs in the phone's OWN speech recognizer, which is why this
      app asks for no RECORD_AUDIO: the recogniser holds that permission and
      hands back text. From API 30 an app cannot even SEE another app's
      activities without declaring the intent it wants to resolve, and without
      this block the mic button would report "no recognizer" on a phone that
      has one.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VitruvianRemote">

        <!--
          resizeableActivity plus the size/orientation config changes are what
          make the fold, unfold and tabletop transitions a re-layout rather
          than an activity restart - without them the shell would lose its
          state every time the device opens.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              vitruvian-remote://<screen>. Used by this app's own notifications
              and by the agent's ntfy Click header, so tapping "Claude Code is
              waiting" lands on the screen that is about it rather than on
              whatever was last open. singleTop above is what makes a link to a
              running app a call to onNewIntent instead of a second activity.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vitruvian-remote" />
            </intent-filter>
        </activity>

        <!--
          The phone bridge's foreground service: one outbound link to the Mac
          agent, and the tool dispatcher behind it.

          exported="false" is load-bearing. The service is started by this app
          and by its own notification action, and nothing else on the phone has
          any business starting a thing that can read the user's messages.
        -->
        <service
            android:name=".bridge.PhoneBridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Approve and Deny on an approval notification. exported="false" for a
          sharper reason than usual: these two intents ARE the consent to send
          a text message, and an exported receiver would let any app on the
          phone broadcast an approval nobody tapped.
        -->
        <receiver
            android:name=".bridge.ApprovalReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.vitruvian.remote.bridge.APPROVE" />
                <action android:name="dev.vitruvian.remote.bridge.DENY" />
            </intent-filter>
        </receiver>

        <!--
          Quick Settings tiles: sleep the Mac's display, and lock it. Both are
          HID key presses, so they need no agent and no pairing.

          BIND_QUICK_SETTINGS_TILE is a permission the SYSTEM must hold to bind
          the service, which is why it is declared here rather than requested;
          exported="true" for the same reason.
        -->
        <service
            android:name=".tiles.SleepDisplayTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_display_sleep"
            android:label="@string/tile_display_sleep"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.LockMacTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock_mac"
            android:label="@string/tile_lock_mac"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
