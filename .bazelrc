# NOTE (#1267): tools/preset.bazelrc is GENERATED by the upstream Aspect
# bazelrc-preset (`bazel run //tools:preset.update`) and ships a `:ci` profile
# whose convention is that CI passes `--config=ci`. THIS REPO NEVER DOES, so
# every `*:ci` line in that file is inert. Verified from Bazel itself rather
# than by grep: `--announce_rc` is on in CI, and the configs it reports applying
# are race / remote / remotecache-ci / remotecache / macos-app -- never `ci`.
# (Do not "confirm" this with `grep --include=*.bazelrc`; that pattern does not
# match .bazelrc or user.bazelrc, which is how it was mis-verified before.)
#
# That is deliberate, not an oversight to fix by adding `--config=ci`: `:ci`
# carries `--remote_download_outputs=minimal`, which on a cache HIT does not
# materialise top-level outputs, so the artifact lanes (extension zip, image
# push, migrate binary) would publish nothing off a green build. #1296 measured
# exactly that. Do not wire `--config=ci` up wholesale. Editing preset.bazelrc
# by hand does not work either -- the generator rewrites it.
#
# Where CI flags actually come from instead:
#   - .github/actions/setup-bazel writes an injected CI bazelrc carrying the
#     cosmetic subset (--announce_rc --color --curses
#     --show_progress_rate_limit --show_timestamps). That file is not in this
#     repo's tree, so grepping here will never find it.
#   - --remote_upload_local_results comes from `:remotecache-ci` (#1296).
#   - --lockfile_mode=error is enforced as its own step in tidy-check.yaml, NOT
#     as a global flag: `bazel mod tidy` in dependabot-bazel-reconcile.yml has
#     to stay able to WRITE the lockfile.
#
# Not adopted on purpose: `--flaky_test_attempts=2` would silently retry the
# very flakes the quarantine policy exists to keep visible
# (docs/engineering/flaky-tests.md, #501/#512).
import %workspace%/tools/preset.bazelrc
try-import %workspace%/tools/java17.bazelrc
# Remote-build (RBE) config — committed, non-secret. Written by
# `bazel run //tools/remote:setup`; activate per-build with `--config=remote`.
try-import %workspace%/tools/remote.bazelrc

# Disable skymeld; see https://github.com/bazelbuild/bazel/issues/23743
# fixes src/main/tools/process-wrapper-legacy.cc:80: "execvp(external/++toolchains+coreutils_linux_amd64/coreutils, ...)": No such file or directory
common --noexperimental_merged_skyframe_analysis_execution
# Use the prebuilt protoc rather than building it from source (matches the
# kitchen-sink; relevant once a .proto target exists).
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# also see: https://blog.aspect.build/configuring-bazels-downloader
common --downloader_config=tools/downloader.cfg
# for speed, passes an argument `--skipLibCheck` to *every* spawn of tsc
common --@aspect_rules_ts//ts:skipLibCheck=always
# use `tsc` for transpiling, even though it's slow.
# TODO(alex): change to SWC by default
common --@aspect_rules_ts//ts:default_to_tsc_transpiler


# rules_python is working to enable this default to avoid dependency on a system interpreter
# See https://github.com/bazel-contrib/rules_python/issues/3187
# NB: some tools run py_binary targets even if the user didn't select to add Python to their project
common --@rules_python//python/config_settings:bootstrap_impl=script
# To stamp release builds, run with
# --config=release
common:release --stamp --workspace_status_command=./tools/workspace_status.sh

common --workspace_status_command=githooks/check-config.sh

# Building the macOS .app (//nexus-agent/macos:NexusAgent) needs Apple's CC
# toolchain for the `objc-executable` link action. On macOS that toolchain is
# otherwise shadowed by the hermetic @llvm_toolchain (the host platform matches
# the same constraints as the apple darwin platform). Scoping it to this config --
# instead of registering it globally in MODULE.bazel -- keeps plain C++/Rust/cgo
# builds on the hermetic LLVM toolchain by default.
# Usage: bazel build --config=macos-app //nexus-agent/macos:NexusAgent
build:macos-app --extra_toolchains=@local_config_apple_cc_toolchains//:all

common:lint --aspects=//tools/lint:linters.bzl%shellcheck
common:lint --aspects=//tools/lint:linters.bzl%eslint
common:lint --aspects=//tools/lint:linters.bzl%ruff
common:lint --aspects=//tools/lint:linters.bzl%ty
common:lint --aspects=//tools/lint:linters.bzl%clang_tidy
common:lint --aspects=//tools/lint:linters.bzl%ktlint
common:lint --aspects=//tools/lint:linters.bzl%pmd

# Share the downloaded-archive cache across every output_base on the machine.
#
# Bazel's repository cache defaults to <output_user_root>/cache/repos/v1. That
# is fine for a single checkout, but //tools/worktree deliberately pins a
# per-worktree `startup --output_user_root=...` (issue #455, so worktrees do not
# contend on one Bazel server) -- and relocating the output_user_root silently
# relocates the download cache with it. Every worktree therefore re-downloads
# every external archive from scratch.
#
# Measured on this repo (fresh output_user_root, `bazel build //devx:devx`):
#   own cache (today):    193s, 9.7 GB downloaded
#   shared cache:          65s, 0 downloaded
# ~3x faster for one small target, and the download saving compounds with every
# worktree a developer creates.
#
# Pinning it here decouples the download cache from output_user_root, so
# worktrees keep their isolated analysis cache and Bazel server while sharing
# archives. `~` is expanded by Bazel (verified). This is deliberately in the
# committed .bazelrc rather than user.bazelrc so every checkout gets it; a
# developer can still override it in their gitignored user.bazelrc, which is
# imported last.
common --repository_cache=~/.cache/bazel/repository-cache

# Load any settings & overrides specific to the current user from `.aspect/bazelrc/user.bazelrc`.
# This file should appear in `.gitignore` so that settings are not shared with team members. This
# should be last statement in this config so the user configuration is able to overwrite flags from
# this file. See https://bazel.build/configure/best-practices#bazelrc-file.
try-import %workspace%/user.bazelrc

# Heavyweight end-to-end suites (//tabula: browser + full service stack) are
# tagged "e2e" and excluded from the default sweep. Run them explicitly with
# `bazel test --config=e2e //tabula/...` (dedicated CI lane).
test --test_tag_filters=-e2e
test:e2e --test_tag_filters=e2e

# Go race detector (`--config=race`).
#
# WHY THIS EXISTS. Bazel runs all 72 go_test targets WITHOUT -race. Race
# coverage came only from a separate non-Bazel job (ci.yaml `go-test`) running
# `go test -race` over exactly two modules, devx and homelab -- so every other
# Go target in the repo, tabula's included, has never been race-tested anywhere.
# ci.yaml said so in a comment; this closes it.
#
# It is a SEPARATE config, not a default on `test`, because flipping it changes
# the build configuration: Bazel reports "Build option --@rules_go//go/config:race
# has changed, discarding analysis cache". Folding race into the default test
# lane would thrash that cache against every non-race build. A dedicated lane
# gets its own runner and output_base, so it pays the analysis once and nothing
# else is disturbed.
#
# Verified 2026-07-27 that this genuinely arms the detector rather than being
# accepted-and-ignored: a deliberately racy test PASSED without the flag and
# FAILED with "WARNING: DATA RACE" with it. Measured cost: 83s for all 72
# targets, 71 passing (the 1 failure is a pre-existing environment dependency in
# //devx/internal/provider, which fails identically without race).
common:race --@rules_go//go/config:race
