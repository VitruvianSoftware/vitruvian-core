Static _Atomic function-pointer initialization with NULL ((void*)0 cast to a
function pointer) is not a valid arithmetic constant expression in strict C11;
clang 15 (this repo's Linux toolchain) rejects it with "initializer element is
not a compile-time constant" while clang >= 16 accepts it. Static storage is
zero-initialized anyway, so the initializer is redundant.
--- a/src/threads_mngr.c
+++ b/src/threads_mngr.c
@@ -24,6 +24,6 @@
 
 /*================================= Globals ================================= */
 
-static redisAtomic run_on_thread_cb g_callback = NULL;
+static redisAtomic run_on_thread_cb g_callback;
 static redisAtomic size_t g_tids_len = 0;
 static redisAtomic size_t g_num_threads_done = 0;
