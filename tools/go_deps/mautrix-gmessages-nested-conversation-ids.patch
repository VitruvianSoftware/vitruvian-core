+// Google now sends some messages and conversation updates with the top-level message ID (field 1) and conversation
+// ID (field 7) empty, and carries the real ones in nested fields instead: the conversation ID (and the phone) in
+// field 23 (someKindOfGroupID), the message ID in field 24 (anotherMessageID), and a conversation's latest message ID
+// in field 35. Left alone, every such event shares the empty ID: the bridge keys one chat on "" and the messages in
+// it overwrite one another. These fill the top-level ID from the nested one when it is empty, and only then.
+
+func fillMissingConversationIDs(conv *gmproto.Conversation) {
+	if conv == nil {
+		return
+	}
+	if conv.ConversationID == "" {
+		conv.ConversationID = conv.GetSomeKindOfGroupID().GetConversationID()
+	}
+	if conv.LatestMessageID == "" {
+		conv.LatestMessageID = conv.GetLatestMessageAnotherID().GetMessageID()
+	}
+}
+
+func fillMissingMessageIDs(msg *gmproto.Message) {
+	if msg == nil {
+		return
+	}
+	if msg.MessageID == "" {
+		msg.MessageID = msg.GetAnotherMessageID().GetMessageID()
+	}
+	if msg.ConversationID == "" {
+		msg.ConversationID = msg.GetSomeKindOfGroupID().GetConversationID()
+	}
+}
+
+func fillMissingTypingIDs(typing *gmproto.TypingData) {
+	if typing == nil {
+		return
+	}
+	if typing.ConversationID == "" {
+		typing.ConversationID = typing.GetSomeKindOfGroupID().GetConversationID()
+	}
+}
+
+// FillMissingIDs fills the empty top-level conversation and message IDs of every conversation, message and typing
+// notice in an update or response from the nested IDs Google sends them in (see above). It runs on everything
+// decryptInternalMessage decodes. Exported so it can be tested from outside the module.
+func FillMissingIDs(data proto.Message) {
+	switch typed := data.(type) {
+	case *gmproto.UpdateEvents:
+		for _, conv := range typed.GetConversationEvent().GetData() {
+			fillMissingConversationIDs(conv)
+		}
+		for _, msg := range typed.GetMessageEvent().GetData() {
+			fillMissingMessageIDs(msg)
+		}
+		fillMissingTypingIDs(typed.GetTypingEvent().GetData())
+	case *gmproto.ListConversationsResponse:
+		for _, conv := range typed.GetConversations() {
+			fillMissingConversationIDs(conv)
+		}
+	case *gmproto.GetConversationResponse:
+		fillMissingConversationIDs(typed.GetConversation())
+	case *gmproto.GetOrCreateConversationResponse:
+		fillMissingConversationIDs(typed.GetConversation())
+	case *gmproto.ListMessagesResponse:
+		for _, msg := range typed.GetMessages() {
+			fillMissingMessageIDs(msg)
+		}
+	}
+}
