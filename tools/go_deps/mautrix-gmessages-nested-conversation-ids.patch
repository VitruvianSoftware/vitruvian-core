+// revertDMMapping puts back the mapping row deduplicateDM replaced with newPortalID's (the portal move that was to
+// follow it failed), in the database and in the caches. The caller holds dmsLock.
+func (gc *GMClient) revertDMMapping(ctx context.Context, old *gmdb.DirectConversation, newPortalID networkid.PortalID) error {
+	replacement := gc.dmsByConv[newPortalID]
+	err := gc.Main.br.DB.DoTxn(ctx, nil, func(ctx context.Context) error {
+		if replacement != nil {
+			err := gc.Main.DB.DirectConversation.Delete(ctx, replacement)
+			if err != nil {
+				return err
+			}
+		}
+		return gc.Main.DB.DirectConversation.Insert(ctx, old)
+	})
+	if err != nil {
+		return err
+	}
+	delete(gc.dmsByConv, newPortalID)
+	gc.dmsByPhone[old.PhoneNumber] = old
+	gc.dmsByConv[old.PortalID] = old
+	return nil
+}
