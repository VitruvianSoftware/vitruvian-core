+			gc.Main.br.QueueRemoteEvent(gc.UserLogin, otherReadEvt)
+		}
 	}
 }
 
+// otherReadReceiptForConv is the other person's read receipt for a direct chat whose latest message is mine and
+// already read (OUTGOING_DISPLAYED) when the conversation is synced. Without it, a message read while the bridge
+// was not watching (another web session was active, or the bridge was offline) never gets a receipt, because
+// receipts are only sent when a live message update changes the status to read. Nil for groups (the
+// conversation doesn't say who read it) and when the chat's room doesn't exist yet.
+func (gc *GMClient) otherReadReceiptForConv(ctx context.Context, v *gmproto.Conversation) *simplevent.Receipt {
+	latest := v.GetLatestMessage()
+	if v.GetIsGroupChat() || v.GetLatestMessageID() == "" || latest.GetFromMe() == 0 ||
+		latest.GetLatestMessageStatus().GetStatus() != gmproto.MessageStatusType_OUTGOING_DISPLAYED {
+		return nil
+	}
+	portal, err := gc.Main.br.GetExistingPortalByKey(ctx, gc.portalKeyForConv(v))
+	if err != nil || portal == nil || portal.OtherUserID == "" {
+		return nil
+	}
+	return &simplevent.Receipt{
+		EventMeta: simplevent.EventMeta{
+			Type:      bridgev2.RemoteEventReadReceipt,
+			PortalKey: portal.PortalKey,
+			Sender:    bridgev2.EventSender{Sender: portal.OtherUserID},
+		},
+		LastTarget: gc.MakeMessageID(v.LatestMessageID),
+	}
+}
+
 var errDontSyncConversation = errors.New("conversation should not be synced")
 
