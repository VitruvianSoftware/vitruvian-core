+++ b/pkg/connector/chatsync.go	2026-11-13 15:37:20
@@ -363,13 +363,46 @@
 			gc.Main.br.QueueRemoteEvent(gc.UserLogin, backfillEvt)
 			if markReadEvt != nil {
 				gc.Main.br.QueueRemoteEvent(gc.UserLogin, markReadEvt)
+			}
+			if otherReadEvt := gc.otherReadReceiptForConv(backfillCtx, v); otherReadEvt != nil {
+				gc.Main.br.QueueRemoteEvent(gc.UserLogin, otherReadEvt)
 			}
 		}()
-	} else if markReadEvt != nil {
