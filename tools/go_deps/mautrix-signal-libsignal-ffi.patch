Courier (apps/desktop/courier): link go.mau.fi/mautrix-signal's libsignalgo
against //third_party/libsignal:signal_ffi, the libsignal_ffi.a Bazel builds
from source, instead of a prebuilt library on the linker search path.

- cflags.go: drop -lsignal_ffi (the archive comes in through cdeps; there is
  no -L for it to search) and link libc++ on darwin, where the macOS SDK has
  no libstdc++.
- BUILD.bazel (generated by gazelle; go_repository applies patches after
  gazelle runs): add the cdeps and the same link flags.

diff -ru a/pkg/libsignalgo/BUILD.bazel b/pkg/libsignalgo/BUILD.bazel
--- a/pkg/libsignalgo/BUILD.bazel	2026-10-16 00:27:40
+++ b/pkg/libsignalgo/BUILD.bazel	2026-10-16 00:27:40
@@ -57,7 +57,8 @@
         "storeutil.go",
     ],
     cgo = True,
-    clinkopts = ["-lsignal_ffi -ldl -lm -lz -lstdc++"],
+    cdeps = ["@@//third_party/libsignal:signal_ffi"],
+    clinkopts = ["-ldl -lm -lz"],
     importpath = "go.mau.fi/mautrix-signal/pkg/libsignalgo",
     visibility = ["//visibility:public"],
     deps = [
diff -ru a/pkg/libsignalgo/cflags.go b/pkg/libsignalgo/cflags.go
--- a/pkg/libsignalgo/cflags.go	2026-10-16 00:27:40
+++ b/pkg/libsignalgo/cflags.go	2026-10-16 00:27:40
@@ -1,7 +1,9 @@
 package libsignalgo
 
 /*
-#cgo LDFLAGS: -lsignal_ffi -ldl -lm -lz -lstdc++
+#cgo LDFLAGS: -ldl -lm -lz
+#cgo darwin LDFLAGS: -lc++
+#cgo !darwin LDFLAGS: -lstdc++
 */
 import "C"
 
