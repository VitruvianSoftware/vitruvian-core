# Public package entrypoint. Replace this placeholder filegroup with the
# library rule for your language (rust_library, go_library, swift_library,
# js_library, kt_jvm_library, ...), keeping every helper target private.
package(default_visibility = ["//visibility:private"])

filegroup(
    name = "{{ target_name }}",
    srcs = ["README.md"],
    visibility = ["//visibility:public"],
)
