{
  "harness2": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./hooks/pre-invocation.sh",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/pre-tool-use.sh",
