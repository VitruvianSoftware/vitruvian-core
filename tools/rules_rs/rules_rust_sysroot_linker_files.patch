#
# Symlink `target_files` (rather than `target.files`) in `_symlink_sysroot_tree`
# so `rust-lld`'s `data` files (`lib/rustlib/<triple>/bin/gcc-ld/*`) are
# symlinked into the generated sysroot and included in `toolchain.all_files`.
# Since Rust 1.90, `x86_64-unknown-linux-gnu` defaults to the self-contained
# lld linker (`gcc-ld/ld.lld`); dropping `target_files` omits `gcc-ld/*` from
# remote execution inputs and fails with "the self-contained linker was
# requested, but it wasn't found in the target's sysroot, or in rustc's sysroot".

--- a/rust/toolchain.bzl
+++ b/rust/toolchain.bzl
@@ -152,7 +152,7 @@ def _symlink_sysroot_tree(ctx, name, target, target_files = None):
     tree_files = []
     if target_files == None:
         target_files = target.files
-    for file in target.files.to_list():
+    for file in target_files.to_list():
         # Parse the path to the file relative to the workspace root so a
         # symlink matching this path can be created within the sysroot.
 
