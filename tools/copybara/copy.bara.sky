# tools/copybara/copy.bara.sky
#
# Copybara configuration for syncing the mcp-slack component between the
# vitruvian-core monorepo and the standalone VitruvianSoftware/mcp-slack repo.
#
# Scope:
#   - EXPORT (monorepo mcp-slack/ -> standalone repo root), push to `main`.
#   - IMPORT (standalone repo root -> monorepo mcp-slack/), push to `main`.
# The export path was first validated green in CI against a `copybara-pilot`
# scratch branch; both directions now target `main`. The first run against a
# fresh destination (no rev-id baseline yet) needs a one-time `--force` to seed
# the baseline; normal runs use --ignore-noop and rely on the rev-id labels.
#
# ---------------------------------------------------------------------------
# LOOP PREVENTION (bidirectional, on-push peer sync)  -- VERIFIED LOCALLY
# ---------------------------------------------------------------------------
# In a peer bidirectional setup an EXPORTed change must not bounce back as an
# IMPORT (and vice-versa), or the two repos ping-pong forever. We prevent this
# with two cooperating mechanisms (BOTH required):
#
#   1. Distinct per-direction rev-id labels.
#      By default Copybara stamps every migrated change with `GitOrigin-RevId`.
#      If BOTH directions used that default label they could not tell their own
#      footprint apart from the peer's. Instead each direction stamps the
#      destination with its OWN label (see `experimental_custom_rev_id` below):
#        - export stamps `MONOREPO_REV_ID`    (change came FROM the monorepo)
#        - import stamps `MCP_SLACK_REV_ID`   (change came FROM the standalone)
#
#   2. A dynamic transform that SKIPs (no-op) any change already carrying the
#      OTHER direction's label. `ctx.find_label(name)` returns the label value
#      or None; if the peer's label is present the change originated from the
#      peer, so we `core.fail_with_noop(...)` to drop it instead of migrating
#      it back. This NOOP (exit code 4) is what breaks the loop.
#
# COPYBARA VERSION NOTE (important for upgrades):
#   This config was VERIFIED end-to-end against `olivr/copybara:latest`
#   (build date 2023-01, "Unknown version"). That build:
#     - exposes the parameter as `experimental_custom_rev_id` (NOT the newer
#       `custom_rev_id` -- the rename landed in Copybara ~late-2023), and
#     - enforces the older label format `[A-Z][A-Z_0-9]{1,30}_REV_ID`
#       (hence `MONOREPO_REV_ID` / `MCP_SLACK_REV_ID`; the modern `Xxx-RevId`
#       form is NOT accepted by this build).
#   On a CURRENT Copybara, make exactly these two edits (logic is identical):
#     - rename `experimental_custom_rev_id` -> `custom_rev_id`, and
#     - the `_REV_ID` labels keep working (modern format is a superset:
#       `([A-Z][A-Z_0-9]{1,30}_REV_ID | [A-Z][a-zA-Z0-9-]{1,30}-RevId)`).
#
# HISTORY MODE (ITERATIVE -- required for correct bidi; do NOT use SQUASH):
#   We migrate one commit at a time so the skip guard runs PER COMMIT, dropping
#   only the peer-origin commits while migrating the genuine ones.
#
#   SQUASH is WRONG here: it evaluates the skip guard over the labels of the
#   WHOLE squashed range, so a range that merely *contains* a peer-origin commit
#   is skipped ENTIRELY -- including genuine changes batched with it. Verified in
#   CI 2026-05-26: an import lands on monorepo main (carrying MCP_SLACK_REV_ID,
#   pushed via GITHUB_TOKEN so it does NOT advance the export baseline), then the
#   next export range includes it and SQUASH skipped the genuine change too --
#   the export direction got stuck. ITERATIVE fixes this.

# AUTH SPLIT: in CI (olivr/copybara-action) the monorepo is reached over HTTPS
# authenticated by the workflow's GITHUB_TOKEN (which only has access to
# vitruvian-core, the repo the workflow runs in); the standalone is reached over
# SSH using the mcp-slack write deploy key (the action's `ssh_key` input).
# copybara-action mounts both an HTTPS credential store and an SSH key with no
# URL rewriting, so the two schemes coexist, selected per URL.
MONOREPO = "https://github.com/VitruvianSoftware/vitruvian-core.git"
STANDALONE = "git@github.com:VitruvianSoftware/mcp-slack.git"
AUTHOR = "VitruvianSoftware Sync <sync@vitruviansoftware.com>"

# Per-direction rev-id labels (see LOOP PREVENTION note above).
# Format constrained by the pinned Copybara build to `[A-Z][A-Z_0-9]{1,30}_REV_ID`.
MONOREPO_REV_ID = "MONOREPO_REV_ID"
STANDALONE_REV_ID = "MCP_SLACK_REV_ID"


def _skip_imported_changes(ctx):
    """EXPORT guard: skip changes that the import workflow brought into the
    monorepo FROM the standalone repo. Such changes carry the import label
    (`MCP_SLACK_REV_ID`); re-exporting them would bounce them back to standalone.
    """
    if ctx.find_label(STANDALONE_REV_ID):
        core.fail_with_noop(
            "export_mcp_slack: skipping change that originated from the"
            + " standalone mcp-slack repo (carries " + STANDALONE_REV_ID + ").")


def _skip_exported_changes(ctx):
    """IMPORT guard: skip changes that the export workflow pushed to the
    standalone repo FROM the monorepo. Such changes carry the export label
    (`MONOREPO_REV_ID`); re-importing them would bounce them back to the monorepo.
    """
    if ctx.find_label(MONOREPO_REV_ID):
        core.fail_with_noop(
            "import_mcp_slack: skipping change that originated from the"
            + " vitruvian-core monorepo (carries " + MONOREPO_REV_ID + ").")


# Export: vitruvian-core/mcp-slack/  ->  VitruvianSoftware/mcp-slack (repo root)
core.workflow(
    name = "export_mcp_slack",
    origin = git.origin(
        url = MONOREPO,
        ref = "main",
    ),
    destination = git.destination(
        url = STANDALONE,
        fetch = "main",
        push = "main",
    ),
    # mcp-slack/BUILD is a monorepo-only Bazel file; never export it.
    origin_files = glob(["mcp-slack/**"], exclude = ["mcp-slack/BUILD"]),
    # Manage all standalone files EXCEPT standalone-only ones: the npm lockfile
    # and the dispatch workflow (which lives only in the standalone repo). The
    # sync must never delete these.
    destination_files = glob(["**"], exclude = ["package-lock.json", ".github/workflows/sync-to-monorepo.yaml"]),
    authoring = authoring.pass_thru(default = AUTHOR),
    mode = "ITERATIVE",
    # Stamp the destination with the monorepo's own rev-id label, and drop any
    # change that the import direction brought in (carries the standalone label).
    experimental_custom_rev_id = MONOREPO_REV_ID,
    transformations = [
        core.dynamic_transform(impl = _skip_imported_changes),
        # Strip the `mcp-slack/` prefix so the component lands at the repo root.
        core.move("mcp-slack", ""),
    ],
)

# Import: VitruvianSoftware/mcp-slack (repo root)  ->  vitruvian-core/mcp-slack/
core.workflow(
    name = "import_mcp_slack",
    origin = git.origin(
        url = STANDALONE,
        ref = "main",
    ),
    destination = git.destination(
        url = MONOREPO,
        fetch = "main",
        push = "main",
    ),
    # Standalone-only files (the npm lockfile and the dispatch workflow) must
    # never be imported into the Bazel monorepo (which uses the root
    # pnpm-lock.yaml and has no dispatch workflow).
    origin_files = glob(["**"], exclude = ["package-lock.json", ".github/workflows/sync-to-monorepo.yaml"]),
    # Manage the monorepo's mcp-slack/ EXCEPT mcp-slack/BUILD (monorepo-only
    # Bazel file) so the sync never deletes it.
    destination_files = glob(["mcp-slack/**"], exclude = ["mcp-slack/BUILD"]),
    authoring = authoring.pass_thru(default = AUTHOR),
    mode = "ITERATIVE",
    # Stamp the destination with the standalone's own rev-id label, and drop any
    # change that the export direction pushed out (carries the monorepo label).
    experimental_custom_rev_id = STANDALONE_REV_ID,
    transformations = [
        core.dynamic_transform(impl = _skip_exported_changes),
        # Re-add the `mcp-slack/` prefix so the standalone repo root lands
        # under the component directory in the monorepo.
        core.move("", "mcp-slack"),
    ],
)
