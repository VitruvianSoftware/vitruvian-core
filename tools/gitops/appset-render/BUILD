# gazelle:ignore
# Hand-maintained: the default :appset-render is the Rust port, which gazelle
# would otherwise replace with a go_binary of the same name. Keep the Go
# targets below in step with main.go by hand.

load("@aspect_rules_py//py:defs.bzl", "py_test")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# The Go original, which parses with Go's own text/template. It stays
# buildable as :appset-render-go (tools/ci/gitops-validate.sh still runs
# main.go directly), and the parity test below holds the Rust port to it.
go_library(
    name = "appset_render_lib",
    srcs = ["main.go"],
    importpath = "github.com/VitruvianSoftware/vitruvian-core/tools/gitops/appset-render",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "appset-render-go",
    embed = [":appset_render_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "appset_render_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":appset_render_lib"],
)

alias(
    name = "appset-render_test",
    actual = ":appset_render_test",
)

# main.go in Rust, standard library only. src/parse.rs is Go 1.26's
# text/template/parse lexer and parser, src/gofmt.rs the fmt verbs its errors
# go through, src/numbers.rs the strconv/Sscan number rules, and
# src/unicode_tables.rs Go's own Unicode tables (generated by
# :gen-unicode-tables below). Optimised in every build mode.
rust_library(
    name = "appset_render_rs_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "appset_render",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_flags = ["-Copt-level=3"],
)

# `bazel run //tools/gitops/appset-render` — check every ApplicationSet under
# gitops/argocd parses as the ArgoCD controller would parse it.
rust_binary(
    name = "appset-render",
    srcs = ["src/main.rs"],
    edition = "2021",
    rustc_flags = ["-Copt-level=3"],
    visibility = ["//visibility:public"],
    deps = [":appset_render_rs_lib"],
)

alias(
    name = "appset_render",
    actual = ":appset-render",
    visibility = ["//visibility:public"],
)

alias(
    name = "appset-render-rs",
    actual = ":appset-render",
    visibility = ["//visibility:public"],
)

alias(
    name = "appset_render_rs",
    actual = ":appset-render",
    visibility = ["//visibility:public"],
)

# main_test.go's cases in Rust, plus exact error text.
rust_test(
    name = "appset_render_rs_lib_test",
    size = "small",
    crate = ":appset_render_rs_lib",
    edition = "2021",
    rustc_flags = ["-Copt-level=3"],
)

# Runs the Go binary and the Rust binary side by side and compares exit code,
# stdout and stderr byte for byte: on the repo's real ApplicationSets, on
# every main_test.go scenario, on generated mutations of the real files, on a
# corpus of template edge cases (each a file of its own), and on flags,
# missing and unreadable paths and file names with fmt verbs in them.
py_test(
    name = "appset_render_rs_parity_test",
    size = "medium",
    srcs = ["appset_render_rs_parity_test.py"],
    # main.go is here so the test can find the source tree (and with it
    # gitops/argocd) through its runfile symlink, as lint-naming's does.
    data = [
        "main.go",
        ":appset-render",
        ":appset-render-go",
    ],
    env = {
        "APPSET_RENDER_GO": "$(rootpath :appset-render-go)",
        "APPSET_RENDER_RS": "$(rootpath :appset-render)",
    },
    main = "appset_render_rs_parity_test.py",
)
