//
// Headscale ACL policy: the source of truth for who may reach what on the
// mesh. Headscale stores its policy in its database (HEADSCALE_POLICY_MODE=
// database, so Headplane's ACL page keeps working), so this file does not
// apply itself. Apply it after it merges:
//
//   bazel run //tools/gitops:headscale-policy-check   # validate against live Headscale
//   bazel run //tools/gitops:headscale-policy-set     # check, then replace the live policy
//
// An edit made in Headplane is overwritten by the next policy-set. Make the
// change here instead. The file is .hujson on purpose: Argo CD's directory
// source reads *.yaml/*.yml/*.json, so it never tries to apply this.
{
  "tagOwners": {
    // Ephemeral GitHub Actions runners (Zitadel and Sentry apply workflows). They
    // join with the HEADSCALE_CI_AUTHKEY pre-auth key, which carries this tag.
    "tag:ci": ["james@"]
  },
  "hosts": {
    // The wired, bare-metal cluster nodes' headscale-node-agent addresses.
    // Keep in step with .github/actions/homelab-tunnel-setup/action.yml.
    "fedora": "100.64.0.7/32",
    "nuc9i5": "100.64.0.6/32",
    "nuc9i9": "100.64.0.8/32"
  },
  "acls": [
    {
      // Every device James owns may reach everything, as under the previous
      // allow-all policy. "james@" owns every node today; the second entry is
      // the same person's OIDC (Google) login, for devices registered through
      // it. Tagged devices belong to no user, so this rule does not cover them.
      // (Headscale v0.26.1 has no autogroup:member.)
      "action": "accept",
      "src": ["james@", "james.nguyen@gmail.com"],
      "dst": ["*:*"]
    },
    {
      // CI reaches the Envoy gateway's HTTP (:30265) and HTTPS (:31103)
      // NodePorts on the cluster nodes over TCP, and nothing else (no UDP, no
      // ICMP, no other port).
      "action": "accept",
      "src": ["tag:ci"],
      "proto": "tcp",
      "dst": [
        "fedora:30265",
        "nuc9i5:30265",
        "nuc9i9:30265",
        "fedora:31103",
        "nuc9i5:31103",
        "nuc9i9:31103"
      ]
    }
  ]
}
