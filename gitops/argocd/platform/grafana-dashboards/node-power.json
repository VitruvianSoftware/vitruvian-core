    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-Data" },
      "description": "macOS host battery charge and battery power flow (discharge watts > 0 only when running off battery; ~0 on AC).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
