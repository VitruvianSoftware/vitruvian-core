#
# Build-context filter for apps/web/gods-eye-view/Dockerfile when invoked with
# the repository root as the Docker build context. Whitelists only the root
# workspace manifests and apps/web/gods-eye-view/.

*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!apps
apps/*
!apps/web
apps/web/*
!apps/web/gods-eye-view
apps/web/gods-eye-view/**/node_modules
apps/web/gods-eye-view/dist
apps/web/gods-eye-view/.git
apps/web/gods-eye-view/.cache
apps/web/gods-eye-view/.gev-cache
apps/web/gods-eye-view/bazel-*
apps/web/gods-eye-view/.env*
apps/web/gods-eye-view/*.pem
apps/web/gods-eye-view/*.key
apps/web/gods-eye-view/secrets*
apps/web/gods-eye-view/tests
apps/web/gods-eye-view/docs
apps/web/gods-eye-view/upstream
apps/web/gods-eye-view/pinokio
apps/web/gods-eye-view/changelog.d
apps/web/gods-eye-view/tools
