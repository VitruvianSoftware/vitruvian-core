# gazelle:ignore

load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//apps/web/gods-eye-view:vite/package_json.bzl", vite = "bin")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/doctor:defs.bzl", "doctor")
load("//tools/pipeline:defs.bzl", "pipeline_unit")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

vite.vite(
    name = "build",
    srcs = glob(
        [
            "src/**",
            "public/**",
            "config/**",
            "scripts/**",
            "pinokio/**",
            # vite.config.js re-exports server/standalone/vite.config.js, which
            # builds on build/vite.js; both trees are inputs to the bundle.
            "server/**",
            "build/**",
        ],
        exclude = ["scripts/src/**"],
    ) + [
        "index.html",
        "package.json",
        "style.css",
        "vite.config.js",
        ":node_modules",
    ],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

js_test(
    name = "unit_tests",
    # Upstream's suite is ~6000 subtests: past 300 s under the sandbox.
    size = "large",
    chdir = package_name(),
    data = glob(
        [
            "src/**",
            "scripts/**",
            "public/**",
            "config/**",
            "docs/**",
            "changelog.d/**",
            "pinokio/**",
            "tools/**",
            "server/**",
            "build/**",
        ],
        exclude = ["scripts/src/**"],
    ) + glob(
        ["*"],
        exclude = ["BUILD.bazel"],
    ) + [
        # src/tooling/streetLevelQa.test.mjs reads upstream's CI workflow.
        ".github/workflows/ci.yml",
        ":node_modules",
    ],
    entry_point = "scripts/bazel-unit-tests.mjs",
)

# Boots server.mjs from the Dockerfile's runtime-stage layout and checks it
# serves every route upstream mounts for `vite preview`, so an upstream file the
# image lacks, or a route production misses, fails here first.
js_test(
    name = "server_test",
    size = "medium",
    chdir = package_name(),
    data = [
        "Dockerfile",
        "package.json",
        "server.mjs",
        "tests/server/no-network.mjs",
        ":node_modules",
    ] + glob(
        [
            "build/**",
            "config/**",
            "scripts/**",
            "server/**",
            "src/**",
        ],
        exclude = ["scripts/src/**"],
    ),
    entry_point = "tests/server/image.test.mjs",
)

# The TLE mirror's group list against the client's, and its refresh logic.
js_test(
    name = "tle_mirror_test",
    size = "small",
    chdir = package_name(),
    data = ["package.json"] + glob([
        "src/**/*.js",
        "src/**/*.mjs",
        "tle-mirror/**",
    ]),
    entry_point = "tle-mirror/mirror.test.mjs",
)

sh_test(
    name = "cesium_assets_test",
    size = "small",
    srcs = ["scripts/verify-cesium-assets.sh"],
    data = [":build"],
)

