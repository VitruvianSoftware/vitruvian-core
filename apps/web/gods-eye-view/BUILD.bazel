# --- Upstream tracking ---------------------------------------------------------
# upstream/README.md: this copy is upstream bilawalsidhu/gods-eye-view at the
# base in upstream/local-changes.tsv, plus the changes that file lists.
#   bazel run //apps/web/gods-eye-view:track_upstream -- status|check|sync
# .github/workflows/gods-eye-view-upstream-watch.yaml runs `status` daily.

py_binary(
    name = "track_upstream",
    srcs = ["upstream/upstream.py"],
    main = "upstream/upstream.py",
)

# The tool against throwaway repositories, and the committed list's format.
py_test(
    name = "upstream_test",
    size = "small",
    srcs = [
        "upstream/upstream.py",
        "upstream/upstream_test.py",
    ],
    data = ["upstream/local-changes.tsv"],
    env = {"UPSTREAM_LOCAL_CHANGES": "$(rootpath upstream/local-changes.tsv)"},
    main = "upstream/upstream_test.py",
)

local_files = [
    "upstream/local-changes.tsv",
    "upstream/upstream.py",
]

rust_library(
    name = "upstream_rs_lib",
    srcs = glob(
        ["upstream/src/**/*.rs"],
        exclude = ["upstream/src/main.rs"],
    ),
    crate_name = "upstream_rs",
    crate_root = "upstream/src/lib.rs",
    edition = "2021",
    rustc_flags = ["-Copt-level=3"],
)

rust_binary(
    name = "track_upstream_rs",
    srcs = ["upstream/src/main.rs"],
    edition = "2021",
    rustc_flags = ["-Copt-level=3"],
    deps = [":upstream_rs_lib"],
)

rust_test(
    name = "upstream_rs_test",
    size = "small",
    crate = ":upstream_rs_lib",
    data = local_files,
    edition = "2021",
    env = {"UPSTREAM_LOCAL_CHANGES": "$(rootpath upstream/local-changes.tsv)"},
    rustc_flags = ["-Copt-level=3"],
)

pipeline_unit(
    name = "gods-eye-view",
    persona = "frontend",
    runner = "ubuntu-26.04",
    test_targets = [
        ":unit_tests",
        ":server_test",
        ":tle_mirror_test",
        ":cesium_assets_test",
        ":upstream_test",
        ":build",
    ],
    tier = "L1",
    timeout_minutes = 15,
)
