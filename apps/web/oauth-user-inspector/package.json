{
  "type": "module",
  "name": "oauth-user-inspector",
  "version": "1.15.3",
  "description": "OAuth User Inspector with a secure backend for token exchange.",
  "main": "dist-server/server.js",
  "scripts": {
    "build:server": "cargo build --release --manifest-path server/Cargo.toml && mkdir -p dist-server && cp server/target/release/oauth-user-inspector-server dist-server/oauth-user-inspector-server",
    "start": "./start.sh",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:server": "bazel run //apps/web/oauth-user-inspector:oauth-user-inspector-server",
    "dev:frontend": "cd frontend && vite",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "build:frontend": "npm run typecheck:frontend && cd frontend && vite build",
    "build": "npm run build:frontend && npm run build:server",
    "deploy": "bazel run //apps/web/oauth-user-inspector:deploy-cloudbuild",
    "preview": "cd frontend && vite preview",
    "test": "bazel test //apps/web/oauth-user-inspector:unit_tests",
    "setup-dev": "bazel run //apps/web/oauth-user-inspector:setup-dev",
    "cleanup:untrack-builds": "git rm -r --cached dist dist-server && git add .gitignore && (git diff --cached --quiet || git commit -m \"chore: untrack build outputs\")"
  },
  "dependencies": {
    "@google-cloud/logging-winston": "^7.3.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "js-base64": "^3.9.4",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-morph": "^28.0.0",
    "uuid": "^14.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "jest": "^30.5.2",
    "jest-cli": "^30.4.2",
    "jest-environment-node": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.0",
    "postcss": "^8.5.31",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
