# Settings for the public GitHub Pages build (vite build --mode pages): the
# mirror's .github/workflows/pages.yml and Bazel's :build_static both use this
# file, so the values live in one place. All public by design: a browser can
# read every one of them from the built site anyway.

# Online rooms: the homelab rooms server (gitops/argocd/platform/mini-party).
VITE_ROOMS_URL=https://mini-games-rooms.vitruviansoftware.dev

# Analytics: the Umami website registered in
# gitops/argocd/platform/umami/sites-configmap.yaml.
VITE_UMAMI_WEBSITE_ID=b59edda9-e89f-414b-abf3-f0a9c8e80932

# Errors: the mini-party Sentry project's browser DSN
# (infrastructure/pulumi/platform/sentry, output mini-party_dsn_browser).
VITE_SENTRY_DSN=https://e178b313b913c30df1a7334b9b3d393c@sentry-ingest.ipv1337.dev/21
