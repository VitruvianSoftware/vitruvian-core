{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "bootstrap-sha": "4c9e6a57137e486b37c4b73188028f2ccd291d20",
  "packages": {
    "apps/extensions/atrium/vitruvian-github": {
      "package-name": "vitruvian-github",
      "component": "vitruvian-github",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "1.0.0",
      "exclude-paths": ["apps/extensions/atrium/vitruvian-github/.github"],
      "extra-files": [
        "Sources/GitHubToolCore/Version.swift",
        {
          "type": "json",
          "path": "vitruvian-tool.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
