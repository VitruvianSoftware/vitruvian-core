/* Chat menu: marks the open chat read (⌘⇧U). Dimmed when it has no unread messages. */
"Mark as Read" = "Mark as Read";

/* Chat menu: mutes the open chat (⌘⇧M). */
"Mute Chat" = "Mute Chat";

/* Chat menu: unmutes the open chat when it is muted (⌘⇧M). */
"Unmute Chat" = "Unmute Chat";

