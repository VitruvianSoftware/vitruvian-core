      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["apps/desktop/antigravity/plugins/gh-watch/.github"],
      "extra-files": [
        {
          "type": "json",
          "path": "plugin.json",
          "jsonpath": "$.version"
