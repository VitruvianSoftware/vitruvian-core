"""Expose rules_nodejs Darwin Node SHA-256 sums for node.lock verification.

rules_nodejs has no public API for this. The sums it downloads Node with live
only in `NODE_VERSIONS`, in the private file `nodejs/private/node_versions.bzl`
(generated by rules_nodejs's `update-nodejs-versions`); its public files load
that table but do not re-export it, and the toolchain repositories hold the
unpacked Node, not the tarball's checksum. node.lock must hold the same sums
rules_nodejs uses (node_lock_test checks it), so this reads the table where it is.

If a rules_nodejs upgrade moves that file or renames the symbol, this file's
`load` fails when `//apps/desktop/vitruvian-code/macos/claude-helper:node_lock_test`
(or `:rules_nodejs_darwin_sums`) is loaded, with Bazel naming the missing file or
symbol. If the table changes shape, `fail()` below says what to look at. Either
way: find where rules_nodejs keeps its Node checksums now and fix this file; do
not delete the check.
"""

load("@rules_nodejs//nodejs/private:node_versions.bzl", "NODE_VERSIONS")

def _collect_darwin_sums(entries, arm64, amd64):
    for key, val in entries.items():
        if key.endswith("-darwin_arm64") or key.endswith("-darwin_amd64"):
            # ("node-v<ver>-darwin-<arch>.tar.gz", "node-v<ver>-darwin-<arch>", "<sha256>")
            if type(val) != "tuple" or len(val) != 3 or len(val[2]) != 64:
                fail((
                    "rules_nodejs NODE_VERSIONS[%r] is no longer (archive, directory, sha256): " +
                    "%r. It changed shape; update node_lock.bzl (see its docstring)."
                ) % (key, val))
        if key.endswith("-darwin_arm64"):
            ver = key[:-len("-darwin_arm64")]
            arm64[ver] = val[2]
        elif key.endswith("-darwin_amd64"):
            ver = key[:-len("-darwin_amd64")]
            amd64[ver] = val[2]

def _rules_nodejs_darwin_sums_impl(ctx):
    arm64 = {}
    amd64 = {}
    for ver_key, entries in NODE_VERSIONS.items():
        if type(entries) == "dict":
            _collect_darwin_sums(entries, arm64, amd64)
        else:
            _collect_darwin_sums({ver_key: entries}, arm64, amd64)

    out = {}
    for ver in sorted(arm64.keys()):
        if ver in amd64:
            out[ver] = {
                "darwin-arm64": arm64[ver],
                "darwin-x64": amd64[ver],
            }
    if not out:
        fail("rules_nodejs NODE_VERSIONS holds no Node with both darwin_arm64 and darwin_amd64 " +
             "sums; its key naming changed. Update node_lock.bzl (see its docstring).")

    f = ctx.actions.declare_file(ctx.attr.name + ".json")
    ctx.actions.write(
        output = f,
        content = json.encode_indent(out, indent = "  ") + "\n",
    )
    return [DefaultInfo(files = depset([f]))]

rules_nodejs_darwin_sums = rule(
    implementation = _rules_nodejs_darwin_sums_impl,
    attrs = {},
)
