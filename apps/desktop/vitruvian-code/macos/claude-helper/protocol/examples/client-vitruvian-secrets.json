{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "_vitruvian/secrets",
  "params": {
    "env": {
      "ANTHROPIC_API_KEY": "example-api-key-placeholder",
      "CUSTOM_GATEWAY_TOKEN": "example-gateway-token-placeholder"
    },
    "mcpServers": {
      "local-docs": {
        "env": {
          "DOCS_ACCESS_KEY": "example-docs-secret-placeholder"
        }
      },
      "remote-mcp": {
        "headers": {
          "Authorization": "Bearer example-token-placeholder"
        }
      }
    }
  }
}
