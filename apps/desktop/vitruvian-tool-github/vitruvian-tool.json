          "ko": "\ub0b4 \ud480 \ub9ac\ud018\uc2a4\ud2b8 \uc5f4\uae30",
          "uk": "\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u043c\u043e\u0457 \u043f\u0443\u043b-\u0440\u0435\u043a\u0432\u0435\u0441\u0442\u0438",
          "zh-Hans": "\u6253\u5f00\u6211\u7684\u62c9\u53d6\u8bf7\u6c42",
          "zh-TW": "\u6253\u958b\u6211\u7684\u62c9\u53d6\u8acb\u6c42",
          "zh-HK": "\u6253\u958b\u6211\u7684\u62c9\u53d6\u8acb\u6c42"
