{
  "id": "dev.vitruvian.speaker",
  "name": {
    "en": "Vitruvian Speaker"
  },
  "description": {
    "en": "Speaks what you type, or the clipboard, on your Google Home speakers, and keeps broadcasting, quiet hours and the volume at hand."
  },
  "version": "1.42.0",
  "protocol": "2",
  "publisher": "VitruvianSoftware",
  "license": "MIT",
  "icon": "hifispeaker.2",
  "uses": [
    "notify",
    "clipboard.read",
    "open"
  ],
  "contributes": {
    "commands": [
      {
        "id": "sayClipboard",
        "title": {
          "en": "Speak the clipboard"
        },
        "icon": "hifispeaker.2",
        "surfaces": [
          "commandBar",
          "shortcut"
        ]
      },
      {
        "id": "toggleBroadcasting",
        "title": {
          "en": "Turn broadcasting on or off"
        },
        "icon": "power",
        "surfaces": [
          "commandBar"
        ]
      },
      {
        "id": "mute",
        "title": {
          "en": "Mute the speaker"
        },
        "icon": "speaker.slash",
        "surfaces": [
          "commandBar"
        ]
      },
      {
        "id": "unmute",
        "title": {
          "en": "Unmute the speaker"
        },
        "icon": "speaker.wave.2",
        "surfaces": [
          "commandBar"
        ]
      },
      {
        "id": "toggleQuietHours",
        "title": {
          "en": "Turn quiet hours on or off"
        },
        "icon": "moon.zzz",
        "surfaces": [
          "commandBar"
        ]
      }
    ],
    "panels": [
      {
        "id": "speaker",
        "title": {
          "en": "Speaker"
        },
        "placement": "island",
        "icon": "hifispeaker.2"
      },
      {
        "id": "settings",
        "title": {
          "en": "Speaker"
        },
        "placement": "settings"
      }
    ],
    "status": {
      "placement": "island"
    }
  },
  "activation": [
    "onLaunch"
  ],
  "runtime": {
    "kind": "external",
    "exec": "bin/tool"
  }
}
