{
  "name": "nexus-agent",
  "version": "1.16.0",
  "description": "Telegram bot bridging messages to the Antigravity CLI (agy) for remote coding agent access",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "node --watch src/bot.js",
    "typecheck": "tsc --noEmit -p src/tsconfig.json"
  },
  "keywords": [
    "antigravity",
    "agy",
    "telegram",
    "bot",
    "cli",
    "ai"
  ],
  "license": "MIT",
