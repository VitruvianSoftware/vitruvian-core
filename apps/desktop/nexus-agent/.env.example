# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram user IDs
# Find your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=

# Working directory for the Antigravity CLI (where it reads/writes files)
AGY_WORKING_DIR=/path/to/your/project

# Path to the agy binary (optional; found in ~/.local/bin, Homebrew, or PATH)
AGY_BIN=

# Max execution time per prompt in milliseconds (default: 5 minutes)
AGY_TIMEOUT_MS=300000

# Approval mode: yolo (auto-approve everything), accept-edits, plan, default
AGY_APPROVAL_MODE=yolo

# Model (optional, leave blank for agy's default; `agy models` lists them)
AGY_MODEL=

# Reasoning effort: low, medium, high (optional)
AGY_EFFORT=

# AI backend provider: "agy" (default) or "custom"
# When set to "custom", CLI_COMMAND_TEMPLATE is used to invoke the provider.
CLI_PROVIDER=agy

# Command template for custom provider.
# Use {prompt} for the user's message and {model} for the active model.
# Example (Ollama via claude agent):
#   CLI_COMMAND_TEMPLATE=ollama launch claude --model gemma4:31b-cloud -- -p "{prompt}"
CLI_COMMAND_TEMPLATE=

# The pre-migration GEMINI_* names are still read as fallbacks.
