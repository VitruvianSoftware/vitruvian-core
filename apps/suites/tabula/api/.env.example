# Tabula API Environment Variables
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/tabula_dev

# Redis Configuration (Upstash)
REDIS_URL=redis://localhost:6379

# JWT Configuration
# REQUIRED in production: the API refuses to start without JWT_SECRET when
# NODE_ENV=production (no insecure fallback). Dev/test use a labeled fallback.
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
# Access-token lifetime (any value @fastify/jwt accepts, e.g. 1h, 15m). Default 1h.
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d
# Server-side refresh-token (session) lifetime in days. Default 30.
REFRESH_TOKEN_TTL_DAYS=30

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,chrome-extension://*

# Origin the auth callback page posts the token to via postMessage.
# Must be the extension/web-app origin that opened the auth popup, NOT '*'.
# Falls back to the first CORS_ORIGIN entry, then http://localhost:3000.
# Extension example: chrome-extension://<your-extension-id>
AUTH_POSTMESSAGE_ORIGIN=http://localhost:3000

# Max request body size in bytes (default 10MB). Sized to chrome.storage.local
# so a legitimately large workspace PUT is not silently rejected.
BODY_LIMIT_BYTES=10485760

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=debug

# WorkOS
WORKOS_API_KEY=your-workos-api-key
WORKOS_CLIENT_ID=your-workos-client-id

# Google Cloud (for production)
# GCP_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
