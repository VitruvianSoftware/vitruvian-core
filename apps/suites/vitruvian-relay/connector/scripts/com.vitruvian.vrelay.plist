<!--
  vrelay as a user LaunchAgent, filled in by
  `bazel run //apps/suites/vitruvian-relay/connector/scripts:install`
  (the binary, its arguments, the log and PATH). A LaunchAgent, not a LaunchDaemon:
  it runs as the person signed in, in their GUI session, so its ask-first
  dialogs appear on their screen.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vitruvian.vrelay</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BIN__</string>
__ARGS__
	</array>
	<!-- Starts at login, and launchd restarts it whenever it exits. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- launchd's own PATH has no Homebrew or mise: node's folder first. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<!-- The folder must exist before the agent loads (the installer makes
	     it, mode 0700); launchd will not, and the agent would never start. -->
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
