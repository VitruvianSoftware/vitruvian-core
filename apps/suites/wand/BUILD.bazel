# gazelle:ignore

load("//tools/doctor:defs.bzl", "doctor")
load("//tools/pipeline:defs.bzl", "pipeline_unit")

package(default_visibility = ["//apps/suites/wand:__subpackages__"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# Alias to the shared Rust 1.98.1 config_setting so Wand packages can reference
# //apps/suites/wand:rust_1_98_1_enabled without adding a //visibility:public
# hole to this app's package boundary.
alias(
    name = "rust_1_98_1_enabled",
    actual = "//apps/desktop/vitruvian-courier/libsignal:rust_1_98_1_enabled",
)

doctor(
    name = "doctor",
    label = "wand",
    optional = ["direnv"],
    required = [
        "bazel",
        "git",
    ],
)

pipeline_unit(
    name = "wand-macos",
    persona = "frontend",
    runner = "xcode-27",
    test_targets = ["//apps/suites/wand/..."],
    tier = "L1",
    timeout_minutes = 20,
)

pipeline_unit(
    name = "wand-linux",
    persona = "backend",
    runner = "ubuntu-26.04",
    test_targets = [
        "//apps/suites/wand/build/smoke:smoke_test",
        "//apps/suites/wand/core:integration_test",
        "//apps/suites/wand/core:wand_core_clippy",
        "//apps/suites/wand/core:wand_core_unit_test",
        "//apps/suites/wand/desktop:wand",
        "//apps/suites/wand/desktop:wand_clippy",
        "//apps/suites/wand/desktop:wand_desktop_test",
    ],
    tier = "L1",
    timeout_minutes = 20,
)

pipeline_unit(
    name = "wand-android",
    artifacts = {
        "wand-apk": "apps/suites/wand/android/wand_apk.apk",
    },
    persona = "frontend",
    runner = "ubuntu-26.04",
    test_targets = [
        "//apps/suites/wand/android:actions_test",
        "//apps/suites/wand/android:gesture_planner_test",
        "//apps/suites/wand/android:native_engine_test",
        "//apps/suites/wand/android:stroke_coordinator_test",
        "//apps/suites/wand/android:wand_apk",
        "//apps/suites/wand/android/jni:wand_jni_lib",
        "//apps/suites/wand/android/jni:wand_jni_test",
    ],
    tier = "L1",
    timeout_minutes = 20,
)
