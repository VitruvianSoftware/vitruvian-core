      <Complication type="SHORT_TEXT">
        <ListConfiguration id="font_scale">
          <ListOption id="font_standard">
            <PartText x="12" y="24" width="64" height="22">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" slant="NORMAL" color="#FF24140C">
                  <Template>%s<Parameter expression="[COMPLICATION.TEXT] != null ? [COMPLICATION.TEXT] : [HEART_RATE]" /></Template>
