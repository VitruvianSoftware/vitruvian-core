<WatchFace width="450" height="450" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:10:31" />
  <Metadata key="STEP_GOAL" value="10000" />

  <UserConfigurations>
    <ListConfiguration id="bezel_mode" displayName="config_bezel_mode" defaultValue="bezel_full">
      <ListOption id="bezel_full" displayName="config_bezel_full" />
      <ListOption id="bezel_expanded" displayName="config_bezel_expanded" />
    </ListConfiguration>
    <ListConfiguration id="font_scale" displayName="config_font_scale" defaultValue="font_standard">
      <ListOption id="font_standard" displayName="config_font_standard" />
      <ListOption id="font_large" displayName="config_font_large" />
      <ListOption id="font_xlarge" displayName="config_font_xlarge" />
    </ListConfiguration>
  </UserConfigurations>

  <Scene backgroundColor="#ff000000">
    <!-- 1. Dial Base: Switchable between Full Tachymeter Bezel and Expanded Inner Dial (No Bezel) -->
    <ListConfiguration id="bezel_mode">
      <ListOption id="bezel_full">
        <PartImage x="0" y="0" width="450" height="450" name="DialInteractiveFull" alpha="255">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Image resource="dial_interactive" />
        </PartImage>
        <PartImage x="0" y="0" width="450" height="450" name="DialAmbientFull" alpha="0">
          <Variant mode="AMBIENT" target="alpha" value="255" />
          <Image resource="dial_ambient" />
        </PartImage>
      </ListOption>
      <ListOption id="bezel_expanded">
        <PartImage x="0" y="0" width="450" height="450" name="DialInteractiveExpanded" alpha="255">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Image resource="dial_expanded_interactive" />
        </PartImage>
        <PartImage x="0" y="0" width="450" height="450" name="DialAmbientExpanded" alpha="0">
          <Variant mode="AMBIENT" target="alpha" value="255" />
          <Image resource="dial_expanded_ambient" />
        </PartImage>
      </ListOption>
    </ListConfiguration>

    <!-- 2. Top 12h Curved Capsule: World Clock Complication (AMS / UTC) -->
    <ComplicationSlot
        slotId="1"
        name="world_clock_slot"
        displayName="slot_world_clock"
        isCustomizable="TRUE"
        supportedTypes="SHORT_TEXT"
        x="171" y="155" width="108" height="22">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy
          primaryProvider="com.google.android.wearable.sysui/com.google.android.clockwork.sysui.experiences.complications.providers.WorldClockProviderService"
          primaryProviderType="SHORT_TEXT"
          defaultSystemProvider="WORLD_CLOCK"
          defaultSystemProviderType="SHORT_TEXT" />
      <BoundingRoundBox x="0" y="0" width="108" height="22" cornerRadius="11" />
      <Complication type="SHORT_TEXT">
        <ListConfiguration id="font_scale">
          <ListOption id="font_standard">
            <PartText x="4" y="2" width="100" height="18">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="11" weight="BOLD" slant="NORMAL" color="#FFF2F6F9">
                  <Upper>
                    <Template>%s %s<Parameter expression="[COMPLICATION.TITLE] != null ? [COMPLICATION.TITLE] : &quot;UTC&quot;" /><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                  </Upper>
                </Font>
              </Text>
            </PartText>
          </ListOption>
          <ListOption id="font_large">
            <PartText x="2" y="1" width="104" height="20">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" slant="NORMAL" color="#FFF2F6F9">
                  <Upper>
                    <Template>%s %s<Parameter expression="[COMPLICATION.TITLE] != null ? [COMPLICATION.TITLE] : &quot;UTC&quot;" /><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                  </Upper>
                </Font>
              </Text>
            </PartText>
          </ListOption>
          <ListOption id="font_xlarge">
            <PartText x="0" y="0" width="108" height="22">
              <Text align="CENTER" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" slant="NORMAL" color="#FFF2F6F9">
                  <Upper>
                    <Template>%s %s<Parameter expression="[COMPLICATION.TITLE] != null ? [COMPLICATION.TITLE] : &quot;UTC&quot;" /><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                  </Upper>
                </Font>
              </Text>
            </PartText>
          </ListOption>
        </ListConfiguration>
      </Complication>
    </ComplicationSlot>

    <!-- 3. Left 9 o'clock Chronograph Register (Center 130, 225): Heart Rate + Battery -->
    <!-- Rotating analog subdial needle driven by live Heart Rate (40..180 BPM) -->
    <PartImage x="86" y="181" width="88" height="88" name="LeftSubdialNeedle" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Transform target="angle" value="clamp(([HEART_RATE] - 40) * 2.2, 0, 330)" />
      <Image resource="subdial_hand" />
    </PartImage>

    <!-- Live Battery readout inside lower half of 9h subdial -->
    <ListConfiguration id="font_scale">
      <ListOption id="font_standard">
        <PartText x="96" y="229" width="68" height="16" name="LeftSubdialBatteryStd" alpha="255">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="CENTER" ellipsis="FALSE">
            <Font family="SYNC_TO_DEVICE" size="10" weight="BOLD" slant="NORMAL" color="#FFC81D25">
              <Template>♥ %d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
            </Font>
          </Text>
        </PartText>
      </ListOption>
      <ListOption id="font_large">
        <PartText x="94" y="229" width="72" height="18" name="LeftSubdialBatteryLg" alpha="255">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="CENTER" ellipsis="FALSE">
            <Font family="SYNC_TO_DEVICE" size="12" weight="BOLD" slant="NORMAL" color="#FFC81D25">
              <Template>♥ %d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
            </Font>
          </Text>
        </PartText>
      </ListOption>
      <ListOption id="font_xlarge">
        <PartText x="92" y="228" width="76" height="20" name="LeftSubdialBatteryXL" alpha="255">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="CENTER" ellipsis="FALSE">
            <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" slant="NORMAL" color="#FFC81D25">
              <Template>♥ %d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
            </Font>
          </Text>
        </PartText>
      </ListOption>
    </ListConfiguration>

    <!-- Heart Rate Complication Slot (Tappable to open Fitbit Heart Rate) -->
