{
  "security-guidance": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|manage_task|send_command_input",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/security-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/security-check.sh",
        "timeout": 5
      }
    ]
  }
}
