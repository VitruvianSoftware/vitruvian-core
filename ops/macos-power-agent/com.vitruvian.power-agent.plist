<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vitruvian.power-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/vitruvian-power-agent</string>
	</array>
	<!-- Sample + push every 30s (Pushgateway is scraped every 60s, so this keeps
	     its value fresh at scrape time). powermetrics needs root, which a system
	     LaunchDaemon provides. -->
	<key>StartInterval</key>
	<integer>30</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/vitruvian-power-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/vitruvian-power-agent.log</string>
</dict>
</plist>
