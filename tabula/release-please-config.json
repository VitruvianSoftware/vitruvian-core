{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "group-pull-request-title-pattern": "chore(tabula): release ${branch}",
  "bootstrap-sha": "90e8de3b8acbcaf06b0a04dac96bcedca1dee135",
  "packages": {
    "tabula": {
      "package-name": "tabula",
      "component": "tabula",
      "changelog-path": "CHANGELOG.md"
    },
    "tabula/api": {
      "package-name": "@tabula/api",
      "component": "tabula-api",
      "changelog-path": "CHANGELOG.md"
    },
    "tabula/extension": {
      "package-name": "@tabula/extension",
      "component": "tabula-extension",
      "changelog-path": "CHANGELOG.md"
    },
    "tabula/cli": {
      "package-name": "@tabula/cli",
      "component": "tabula-cli",
      "changelog-path": "CHANGELOG.md"
    },
    "tabula/web": {
      "package-name": "@tabula/web",
      "component": "tabula-web",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "tabula",
      "components": [
        "tabula",
        "tabula-api",
        "tabula-extension",
        "tabula-cli",
        "tabula-web"
      ]
    }
  ]
}
