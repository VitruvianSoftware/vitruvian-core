      "$value": "0px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0px"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "0px",
        "spread": "0px",
        "color": "#00000066"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "20px",
        "spread": "0px",
        "color": "#00000073"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "60px",
        "spread": "0px",
        "color": "#00000099"
      }
    }
  },
  "motion": {
    "duration": {
      "1": {
        "$type": "duration",
        "$value": "90ms"
      },
      "2": {
        "$type": "duration",
        "$value": "140ms"
      },
      "3": {
        "$type": "duration",
        "$value": "220ms"
      },
      "4": {
        "$type": "duration",
        "$value": "340ms"
      }
    },
    "easing": {
      "mech": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0.3, 1]
      },
      "snap": {
        "$type": "cubicBezier",
        "$value": [0.45, 0, 0.15, 1]
      }
    }
  },
  "glass": {
    "bg": {
      "$type": "color",
      "$value": "#141b20a8"
    },
    "blur": {
      "$type": "string",
      "$value": "blur(16px) saturate(1.15)",
      "$description": "CSS backdrop-filter. Compose: RenderEffect.createBlurEffect(16f,16f) on API 31+, else an opaque surface."
    },
    "border": {
      "$value": "{color.divider}"
    }
  },
  "light": {
    "color": {
      "bg": {
        "$type": "color",
        "$value": "#eeebe4"
