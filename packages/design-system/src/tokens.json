  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
        ]
      },
      "body": {
        "$type": "fontFamily",
