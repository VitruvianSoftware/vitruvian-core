        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
        ]
      }
    },
    "weight": {
      "display": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Headings never above 500."
      },
      "body": {
        "$type": "fontWeight",
        "$value": 400
      },
      "label": {
        "$type": "fontWeight",
        "$value": 500
      }
    },
    "size": {
