{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "bootstrap-sha": "858211bb2e42122ee13fac04b4a97517675226ef",
  "packages": {
    "packages/vitruvian-sdk": {
      "package-name": "vitruvian-sdk",
      "component": "vitruvian-sdk",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.9.0",
      "exclude-paths": [
        "packages/vitruvian-sdk/.github",
        "packages/vitruvian-sdk/consumers"
      ],
      "extra-files": [
        "Sources/VitruvianToolCLI/Words.swift",
        {
          "type": "json",
          "path": "kits/typescript/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "kits/python/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "json",
          "path": "samples/hello-typescript/package.json",
          "jsonpath": "$.dependencies['@vitruviansoftware/tool-kit']"
        },
        {
          "type": "generic",
          "path": "samples/hello-python-kit/requirements.txt"
        },
        {
          "type": "json",
          "path": "samples/hello-panel-typescript/package.json",
          "jsonpath": "$.dependencies['@vitruviansoftware/tool-kit']"
        },
        {
          "type": "generic",
          "path": "samples/hello-panel-python/requirements.txt"
        },
        {
          "type": "generic",
          "path": "go/toolkit/version.go"
        },
        {
          "type": "toml",
          "path": "kits/rust/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='vitruvian-tool-kit')].version"
        },
        {
          "type": "generic",
          "path": "samples/hello-go/go.mod"
        },
        {
          "type": "generic",
          "path": "samples/hello-panel-go/go.mod"
        },
        {
          "type": "toml",
          "path": "samples/hello-rust/Cargo.toml",
          "jsonpath": "$.dependencies['vitruvian-tool-kit'].version"
        },
        {
          "type": "toml",
          "path": "samples/hello-panel-rust/Cargo.toml",
          "jsonpath": "$.dependencies['vitruvian-tool-kit'].version"
        }
      ]
    }
  }
}
