    "@types/node": "^26.2.0",
    "jest": "30.5.2",
    "jest-cli": "30.4.2",
    "jest-environment-node": "30.5.2",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
