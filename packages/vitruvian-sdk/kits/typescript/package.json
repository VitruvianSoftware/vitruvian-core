  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitruvianSoftware/vitruvian-sdk.git",
    "directory": "kits/typescript"
  },
  "homepage": "https://github.com/VitruvianSoftware/vitruvian-sdk/tree/main/kits/typescript",
  "keywords": [
    "vitruvian",
    "macos",
    "tool",
    "json-rpc"
  ],
  "type": "module",
