{
  "id": "dev.vitruvian.reference2",
  "name": { "en": "Reference tool 2" },
  "description": {
    "en": "Says hello and draws one panel. The smallest tool that speaks protocol 2."
  },
  "version": "0.1.0",
  "protocol": "2",
  "publisher": "VitruvianSoftware",
  "license": "MIT",
  "icon": "hand.wave",
