    ],
    "panels": [
      {
        "id": "hello",
        "title": { "en": "Hello" },
        "placement": "island",
        "icon": "hand.wave"
      }
    ]
  },
  "activation": ["onCommand"],
  "runtime": { "kind": "external", "exec": "bin/reference_tool_2.py" }
}
