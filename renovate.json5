// Renovate — sanctioned for exactly ONE gap: tracking Helm chart version pins
// inside ArgoCD Application/ApplicationSet manifests under gitops/argocd/,
// which Dependabot's ecosystem list has no manager for (confirmed: no
// helm/argocd package-ecosystem exists in .github/dependabot.yml or upstream
// Dependabot docs). Sign-off: James Nguyen, vitruvian-core-buzz channel,
// 2026-07-31 (thread root 5955e5f7ba52d63429c49730945bd5b876bfb7c43419c6fca5410a6aa0b3374d),
// per docs/engineering/application-development-principles.md §2.13
// (new-tool sign-off).
//
// `enabledManagers: ["argocd"]` is deliberate and load-bearing: it disables
// EVERY other Renovate manager (npm, gomod, github-actions, docker, ...),
// so Renovate can never open a duplicate/conflicting PR against anything
// Dependabot already owns (see .github/dependabot.yml). If this gap ever
// widens beyond ArgoCD Helm pins, that is a new decision, not an assumed
// extension of this config.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  enabledManagers: ["argocd", "custom.regex"],
  // custom.regex is the ONE deliberate widening of the above (James,
  // 2026-09-26): MinIO stopped publishing images, so minio-amd64 runs
  // Chainguard's builds pinned by digest inside ApplicationSet helm values,
  // where neither the argocd manager nor Dependabot can see them. Without this,
  // MinIO would never get another security fix. Scoped to that one file.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/^gitops/argocd/platform/minio-amd64/applicationset\\.yaml$/",
      ],
      matchStrings: [
        'repository: (?<depName>cgr\\.dev/chainguard/[a-z-]+)\\s+tag: "(?<currentValue>[a-z0-9.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: "docker",
    },
  ],
  argocd: {
    // Matches this repo's actual layout (verified against gitops/argocd/
    // during the buzz Argo Rollouts scoping work, PR #1342/#1343):
    //   - gitops/argocd/applications/*.yaml   — leaf Applications (e.g. buzz.yaml,
    //     whose Source 1 pins ghcr.io/block/buzz/charts @ targetRevision).
    //   - gitops/argocd/platform/*/applicationset.yaml — platform-service
    //     ApplicationSets that consume an upstream chart as-is (cert-manager,
    //     external-dns, cilium, prometheus, ...).
    managerFilePatterns: [
      "/^gitops/argocd/applications/.+\\.ya?ml$/",
      // Also applicationset-<suffix>.yaml (e.g. cnpg/applicationset-operator.yaml):
      // the exact-name pattern missed it, so the CNPG operator sat at chart
      // 0.23.2 while upstream shipped 0.29.1 without Renovate ever noticing.
      "/^gitops/argocd/platform/[^/]+/applicationset(-[^/]+)?\\.ya?ml$/",
    ],
  },
  // `onboarding`/`requireConfig` are GLOBAL-only options (Renovate rejects them
  // here: "reserved only for Renovate's global configuration") — set instead
  // via RENOVATE_ONBOARDING=false / RENOVATE_REQUIRE_CONFIG=required in
  // .github/workflows/renovate.yml.
  //
  // One PR per chart. buzz's chart-fork question (PR #1342) means every
  // detected bump still needs a human to judge blast radius before merging —
  // group-and-auto-merge is exactly what we do NOT want yet for this class of
  // change (a chart bump can carry a Deployment/probe/RBAC change straight
  // into a self-hosted platform's live reconciliation loop).
  packageRules: [
    {
      matchManagers: ["argocd"],
      groupName: null,
      commitMessagePrefix: "chore(gitops)",
      labels: ["dependencies", "gitops", "helm"],
      automerge: false,
    },
    // Cluster-critical charts: a bad version takes down EVERYTHING, not one
    // app (cilium = all pod networking, cert-manager = all TLS,
    // sealed-secrets = every secret, external-secrets = secret sync,
    // CloudNativePG = every database). Any version change waits on the
    // Dependency Dashboard until a human ticks it, then lands as a
    // deliberate one-at-a-time upgrade (preview, watch).
    {
      matchManagers: ["argocd"],
      matchPackageNames: [
        "cilium",
        "cert-manager",
        "sealed-secrets",
        "external-secrets",
        "external-dns",
      ],
      dependencyDashboardApproval: true,
      labels: ["dependencies", "gitops", "helm", "cluster-critical"],
    },
    {
      matchManagers: ["argocd"],
      matchRegistryUrls: ["https://cloudnative-pg.github.io/charts"],
      dependencyDashboardApproval: true,
      labels: ["dependencies", "gitops", "helm", "cluster-critical"],
    },
    // MinIO SERVER digest bumps: held. The StatefulSet is OnDelete, and a
    // distributed MinIO refuses mixed versions, so a bump must be applied by
    // restarting all 4 pods together, deliberately. Merged unattended, the next
    // single pod restart (node reboot) would start the new version beside
    // three old ones. The mc client (post-sync job only) flows normally.
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["cgr.dev/chainguard/minio"],
      dependencyDashboardApproval: true,
      labels: ["dependencies", "gitops", "cluster-critical"],
    },
    // Major versions anywhere: read the upgrade notes before a PR exists.
    {
      matchManagers: ["argocd"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
  ],
  // One issue listing every pending update, and where the held ones above are
  // approved. It is also what makes a starved or stuck update VISIBLE: until
  // 2026-09-24 nineteen chart updates sat unseen behind the rate limit below.
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency Dashboard (Helm chart pins)",
  // NO `schedule`. The workflow's own cron is the SINGLE cadence authority.
  //
  // This previously read `schedule: ["before 6am on monday"]`, paired with the
  // workflow's `cron: "0 5 * * 1"`, on the assumption that the two "line up".
  // They do not. Renovate's `schedule` gates BRANCH CREATION against the
  // wall-clock at the moment the run executes, and GitHub's scheduled-workflow
  // delivery is best-effort: it routinely lands 30-180 minutes after the cron
  // time. A 05:00 cron with a "before 06:00" window has 60 minutes of slack and
  // has never fit inside it -- both runs on record started outside the window
  // (2026-07-31 07:37 UTC, 2026-08-03 08:36 UTC). Renovate extracted its 36
  // deps, found itself out of schedule, created nothing, and exited
  // `"result": "done"` -- a green run that did no work.
  //
  // The cost was silent and real: with zero PRs ever opened, the pinned charts
  // drifted badly behind upstream while the lane reported success -- e.g.
  // cert-manager pinned v1.17.0 against upstream v1.21.1, external-dns pinned
  // 1.15.0 against upstream 1.21.1 (both measured 2026-08-08).
  //
  // Dropping `schedule` makes every DELIVERED run do its work, whenever GitHub
  // gets round to delivering it. Cadence is still weekly, because the cron is
  // weekly; a mid-week `workflow_dispatch` is now an explicit human asking for
  // updates, which is the only time that happens.
  //
  // `timezone` went with it: it exists only to interpret `schedule`.
  //
  // Review load is bounded by OPEN PRs, not by creation rate.
  //
  // This used to also set prHourlyLimit: 2, meant to trickle out a one-time
  // backlog. But the workflow runs once a week, so "2 per hour" was really
  // "2 per WEEK", forever: every Monday run from 2026-08-31 on opened exactly
  // two PRs, the frequently-released charts (argo-rollouts, buzz) kept taking
  // both slots, and by 2026-09-24 nineteen updates were starved -- including
  // argocd-image-updater 1.2.4 -> 1.3.1, three weeks old. The concurrency cap
  // alone does the trickling: at most 3 chart PRs await review at once, and
  // each merge frees a slot for the next run.
  prConcurrentLimit: 3,
  prHourlyLimit: 0,
}
