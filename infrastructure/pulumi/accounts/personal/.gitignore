# Per-stack config (Pulumi.<stack>.yaml) holds environment-specific settings and
# encrypted secrets; the Pulumi Cloud backend is the source of truth. Only the
# project file and the example template are committed.
Pulumi.*.yaml
!Pulumi.yaml
!Pulumi.dev.yaml.example

# Local secrets / credentials — never commit
.env
*.kubeconfig
*-key.json
*-credentials.json
service-account*.json

# Compiled Pulumi program binary left behind by `go build .`
/lab-gmail

# OS/IDE
.DS_Store
.idea/
.vscode/
