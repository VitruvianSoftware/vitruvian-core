root = true

# All files
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Go files strictly use tabs
[*.go]
indent_style = tab
indent_size = 4

# YAML files strictly use spaces
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown uses spaces
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# TOML uses spaces
[*.toml]
indent_style = space
indent_size = 4
