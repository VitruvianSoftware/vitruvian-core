# Pulumi Local Configuration Passphrase
# Used by Pulumi to encrypt/decrypt secrets in state if not using Pulumi Cloud ESC
PULUMI_CONFIG_PASSPHRASE=CHANGE_ME

# ---------------------------------------------------------
# Required Secrets for Enabled Components
# ---------------------------------------------------------
# Replace the placeholder values with your actual tokens

PULUMI_CONFIG_monorepo_github_token="YOUR_GITHUB_TOKEN"
PULUMI_CONFIG_monorepo_cloudflare_api_token="YOUR_CLOUDFLARE_API_TOKEN"

# ---------------------------------------------------------
# Optional Secrets (Uncomment and set if enabling these components)
# ---------------------------------------------------------

# Datadog
# PULUMI_CONFIG_monorepo_datadog_api_key="YOUR_DATADOG_API_KEY"
# PULUMI_CONFIG_monorepo_datadog_app_key="YOUR_DATADOG_APP_KEY"

# Redis
# PULUMI_CONFIG_monorepo_redis_password="YOUR_REDIS_PASSWORD"

# CloudNativePG
# PULUMI_CONFIG_monorepo_cnpg_app_db_password="YOUR_CNPG_APP_DB_PASSWORD"

# MongoDB
# PULUMI_CONFIG_monorepo_mongodb_password="YOUR_MONGODB_PASSWORD"

# ArgoCD
# PULUMI_CONFIG_monorepo_argocd_admin_password="YOUR_ARGOCD_ADMIN_PASSWORD"
