        "linux/arm64",
    ],
)
use_repo(oci, "distroless_base", "distroless_base_linux_amd64", "distroless_base_linux_arm64")

# The ubuntu bases come from Google's pull-through mirror of Docker's official
# images, not Docker Hub and not AWS's public copy: both rate-limit anonymous
# pulls from the addresses GitHub's runners share (429), which fails every
# build on these bases (Hub on 2026-10-09, public ECR five times on
# 2026-10-11..13, issue #3173). Same digest, so the same bytes.
# //tools/conformance:check rejects a Docker Hub image here.
oci.pull(
    name = "python_base",
    digest = "sha256:c35e29c9450151419d9448b0fd75374fec4fff364a27f176fb458d472dfc9e54",
    image = "mirror.gcr.io/library/ubuntu",
    platforms = [
        "linux/arm64/v8",
        "linux/amd64",
    ],
)
use_repo(oci, "python_base", "python_base_linux_amd64", "python_base_linux_arm64_v8")

# Base image for Node.js containers (//tabula/api). js_image_layer ships the
# hermetic Node toolchain in its own layer and the js_binary launcher is a
# shell script, so the base needs a shell — ubuntu, like the Python images
# (distroless/nodejs has no /bin/sh and its bundled node would be unused).
# The engine-free Prisma client (prisma-client generator + driver adapter)
# needs no OpenSSL/zlib beyond what Node links statically.
oci.pull(
    name = "nodejs_base",
    digest = "sha256:c35e29c9450151419d9448b0fd75374fec4fff364a27f176fb458d472dfc9e54",
    image = "mirror.gcr.io/library/ubuntu",
    platforms = [
        "linux/arm64/v8",
        "linux/amd64",
    ],
)
use_repo(oci, "nodejs_base", "nodejs_base_linux_amd64", "nodejs_base_linux_arm64_v8")

register_toolchains("//tools/toolchains:all")
