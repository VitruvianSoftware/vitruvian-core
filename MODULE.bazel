# Hermetic Python interpreter and pip dependencies
bazel_dep(name = "rules_python_gazelle_plugin", version = "1.8.3")
bazel_dep(name = "aspect_rules_py", version = "1.8.4")
bazel_dep(name = "rules_uv", version = "0.89.2")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//requirements:all.txt",
)
use_repo(pip, "pip")

# toolchains_llvm 1.8.0's generated cc_toolchain selects on the rules_cc target
# `//cc/toolchains/args/archiver_flags:use_libtool_on_macos_setting`, which
# rules_cc 0.2.19 renamed away — so 0.2.18 is the newest compatible version
# (a HARD ceiling: do not bump rules_cc past 0.2.18 while on toolchains_llvm 1.8.x).
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

#########################
# Hermetic C++ toolchain, to relieve the dependency on a locally installed CC etc.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    # clang 19 — clang 15's bundled `ld64.lld` couldn't parse recent macOS SDK
    # `.tbd` stubs (the old reason for a per-platform darwin override) and clang
    # 15 can't parse the macOS 15 SDK's libc++ headers. 19.1.7 is the last 19.1.x
    # that ships linux-x64 + darwin-arm64 + darwin-x64, so one entry covers every
    # platform — no per-platform map needed anymore.
    # NB when bumping: ci.yaml pins this distribution's repo-contents hash for
    # the extracted-toolchain cache (#1039, "Restore the extracted LLVM
    # toolchain" in build-test + go-race). A bump changes that hash; the CI
    # tripwire will warn with the replacement value -- update both jobs.
    llvm_versions = {
        "": "19.1.7",
    },
)

# Pin the macOS sysroot instead of taking whatever `xcrun --show-sdk-path`
# reports, which is what toolchains_llvm does by default.
#
# Command Line Tools 27 ships the macOS 27.0 SDK, whose `.tbd` stubs declare
# `arm64e.x1` slices. No released LLVM parses them: 19.1.7, 20.1.7 and 22.1.7
# were each tried against this exact link and all three failed identically with
# "unknown architecture" on nine system libraries, so every cgo and Go host-tool
# link breaks (rules_android's `ak` surfaces it first). It is the SDK that is
# ahead of the toolchain, not the toolchain that is behind on features, so
# bumping clang does not help -- only building against an SDK whose stubs the
# linker understands does.
#
# The 26 SDK ships alongside the 27 one under the same CLT install, so this
# stays within what the machine already has.
#
# REMOVE THIS once upstream lld can read `arm64e.x1`: delete both tags and the
# toolchain goes back to following xcrun.
# boring-sys's BORING_BSSL_SYSROOT (libsignal, below) reads the same _MACOS_SDK:
# remove or change it together with this pin, or bindgen keeps reading the 26
# SDK while the compiler follows xcrun.
_MACOS_SDK = "/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk"

llvm.sysroot(
    path = _MACOS_SDK,
    targets = [
        "darwin-aarch64",
        "darwin-x86_64",
    ],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# Apple's CC toolchain provides the `objc-executable` action_config that
# rules_apple's macos_application needs to link the .app. We make the repo
# available here but deliberately do NOT register it globally: on macOS it would
# shadow @llvm_toolchain for ALL C++ (the host platform is constraint-identical to
# the apple `darwin_*` platform rules_apple transitions to), silently making plain
# C++/Rust/cgo builds non-hermetic. Instead the macOS .app build opts in via
# `--config=macos-app` (see .bazelrc), so the hermetic LLVM toolchain stays the
# default everywhere else.
apple_cc_configure = use_extension("@apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_cc_configure, "local_config_apple_cc_toolchains")

register_toolchains("@llvm_toolchain//:all")

# bazel run @hedron_compile_commands//:refresh_all
bazel_dep(name = "hedron_compile_commands")
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

