# Hermetic Python interpreter and pip dependencies
bazel_dep(name = "rules_python_gazelle_plugin", version = "1.8.3")
bazel_dep(name = "aspect_rules_py", version = "1.8.4")
bazel_dep(name = "rules_uv", version = "0.89.2")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//requirements:all.txt",
)
use_repo(pip, "pip")

# toolchains_llvm 1.8.0's generated cc_toolchain selects on the rules_cc target
# `//cc/toolchains/args/archiver_flags:use_libtool_on_macos_setting`, which
# rules_cc 0.2.19 renamed away — so 0.2.18 is the newest compatible version
# (a HARD ceiling: do not bump rules_cc past 0.2.18 while on toolchains_llvm 1.8.x).
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

#########################
# Hermetic C++ toolchain, to relieve the dependency on a locally installed CC etc.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    # clang 19 — clang 15's bundled `ld64.lld` couldn't parse recent macOS SDK
    # `.tbd` stubs (the old reason for a per-platform darwin override) and clang
    # 15 can't parse the macOS 15 SDK's libc++ headers. 19.1.7 is the last 19.1.x
    # that ships linux-x64 + darwin-arm64 + darwin-x64, so one entry covers every
    # platform — no per-platform map needed anymore.
    llvm_versions = {
        "": "19.1.7",
    },
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# Apple's CC toolchain provides the `objc-executable` action_config that
# rules_apple's macos_application needs to link the .app. We make the repo
# available here but deliberately do NOT register it globally: on macOS it would
# shadow @llvm_toolchain for ALL C++ (the host platform is constraint-identical to
# the apple `darwin_*` platform rules_apple transitions to), silently making plain
# C++/Rust/cgo builds non-hermetic. Instead the macOS .app build opts in via
# `--config=macos-app` (see .bazelrc), so the hermetic LLVM toolchain stays the
# default everywhere else.
apple_cc_configure = use_extension("@apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_cc_configure, "local_config_apple_cc_toolchains")

register_toolchains("@llvm_toolchain//:all")

# bazel run @hedron_compile_commands//:refresh_all
bazel_dep(name = "hedron_compile_commands")
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

#########################
# Support for Rust via rules_rs (https://github.com/hermeticbuild/rules_rs).
# rules_rs is the ONLY direct Rust dep: its rules_rust facade extension (below)
# generates the @rules_rust repo (rules + toolchains), so the old direct
# bazel_dep(rules_rust) + @rules_rust rust extension are dropped.
bazel_dep(name = "rules_rs", version = "0.0.90")

# Clippy lint aspect for rust_{binary,library,test}, re-added via the dedicated
# aspect_rules_lint_rust module (aspect_rules_lint 2.6.0 moved clippy out of
# lint/). Wired into `--config=lint` through //tools/lint:linters.bzl%clippy.
bazel_dep(name = "aspect_rules_lint_rust", version = "0.0.2")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2021",
    # Must match aspect_rules_lint_rust's pinned toolchain version: both
    # contribute a toolchains.toolchain() tag to the same default_rust_toolchains
    # repo, and rules_rs fails the build on a version mismatch.
    version = "1.92.0",
)
use_repo(toolchains, "default_rust_toolchains")

# Register AFTER the hermetic @llvm_toolchain//:all above: aspect_rules_lint_rust
# + rules_rs pull a minimal llvm (0.8.3) that can't link rules_rust's
# process_wrapper; keeping the hermetic LLVM 19.1.7 registered first wins.
register_toolchains("@default_rust_toolchains//:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

