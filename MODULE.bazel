# Hermetic integration/E2E test services (//tabula): rules_itest orchestrates
# Postgres + Redis + the Fastify API as health-checked test services; browsers
# for Playwright come from rules_playwright pinned to the lockfile's version.
bazel_dep(name = "rules_itest", version = "0.0.56")
