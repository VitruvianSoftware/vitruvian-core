use_repo(crate, "mcp_roborock_crates")

# ring compiles C with cc-rs: same execroot problem, same wrapper as Courier's
# libsignal annotation below. Linux too, since CI builds this on Linux.
crate.annotation(
    build_script_env = {
        "CC_aarch64_apple_darwin": "$(execpath @@//apps/desktop/courier/libsignal:cc_in_execroot)",
        "CC_aarch64_unknown_linux_gnu": "$(execpath @@//apps/desktop/courier/libsignal:cc_in_execroot)",
        "CC_x86_64_apple_darwin": "$(execpath @@//apps/desktop/courier/libsignal:cc_in_execroot)",
        "CC_x86_64_unknown_linux_gnu": "$(execpath @@//apps/desktop/courier/libsignal:cc_in_execroot)",
        "COURIER_BAZEL_EXECROOT": "$${pwd}",
    },
    build_script_tools = ["@@//apps/desktop/courier/libsignal:cc_in_execroot"],
    crate = "ring",
    repositories = [
        "mcp_roborock_crates",
        "mcp_slack_crates",
    ],
)

# --- libsignal (Courier's Signal bridge) -----------------------------------
# mautrix-signal's libsignalgo links Signal's Rust library, libsignal_ffi.a,
# through cgo. //apps/desktop/courier/libsignal builds it from source; README.md there
# explains the moving parts and apps/desktop/courier/engine/docs/m2-libsignal.md
# records why it is built this way.
#
# libsignal needs Rust 1.98.1 (its rust-toolchain file). The SDK above stays on
# 1.75.0: these toolchains only match when
# //apps/desktop/courier/libsignal:rust_1_98_1 is true, and only the libsignal targets
# set that flag (by transition). They are registered below, ahead of rules_rust's
# own registration, so they are considered first and skipped everywhere else.
# rules_rust (0.68.1 declared above; the graph resolves 0.69.0) knows checksums
# only up to 1.93.1, so 1.98.1's are pinned here (from
# static.rust-lang.org/dist/*.sha256). The exec side is arm64 only: Apple
# silicon is what builds this (developer Macs, the xcode-27 CI runners).
_RUST_1_98_1_SHA256S = {
    "cargo-1.98.1-aarch64-apple-darwin.tar.xz": "de51d4fade4f31ad8ec405261cc96bedc000d905f98980027610d6e288dbe21b",
    "clippy-1.98.1-aarch64-apple-darwin.tar.xz": "1ad080040ff0f4f8af0751bd7fa1fb1901212f8d164cecaa3c47b0654e0916f2",
    "llvm-tools-1.98.1-aarch64-apple-darwin.tar.xz": "9b68ac31be7c6d25a08ce34dbd2c1d026b8006905e74415b6d9576678379ecbc",
    "rust-std-1.98.1-aarch64-apple-darwin.tar.xz": "2de831ef563ce772519a4d18ba2659f0f7428d497ef66dad24b5a35e8f8cd177",
    "rust-std-1.98.1-x86_64-apple-darwin.tar.xz": "48b9835058a8baa4ff5e4387f3772c572a017a2b13393c46e151615c54e322e9",
    "rustc-1.98.1-aarch64-apple-darwin.tar.xz": "738e3f60114b20550fcf4f8a57c9cea0544239f214709f45594ff3fde327f577",
}

rust.repository_set(
    name = "rust_libsignal_darwin_aarch64",
    edition = "2024",
    exec_triple = "aarch64-apple-darwin",
    sha256s = _RUST_1_98_1_SHA256S,
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    target_settings = ["//apps/desktop/courier/libsignal:rust_1_98_1_enabled"],
    target_triple = "aarch64-apple-darwin",
    versions = ["1.98.1"],
)
rust.repository_set(
    name = "rust_libsignal_darwin_aarch64",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
    target_triple = "x86_64-apple-darwin",
