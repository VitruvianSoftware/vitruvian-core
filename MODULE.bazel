# Hermetic PostgreSQL for //tabula integration/E2E tests (real server binaries,
# initdb'd into $TEST_TMPDIR per test; see //tools/testinfra/postgres).
# gnu-linked builds: the runners/RBE images are glibc (the musl variants are
# dynamically linked against the musl loader, absent on Ubuntu). Pinned to
# PG 16 to match production.
_PG_VERSION = "16.13.0"

_PG_BUILD = """filegroup(
    name = "dist",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "initdb_bin",
    srcs = ["bin/initdb"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "postgres_bin",
    srcs = ["bin/postgres"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pg_isready_bin",
    srcs = ["bin/pg_isready"],
    visibility = ["//visibility:public"],
)"""

http_archive(
    name = "postgresql_linux_amd64",
    build_file_content = _PG_BUILD,
    sha256 = "bb8dba9ca0f04e5cc6e21a13a41a3f111e030ef6c3b41a872e32c6f9e5a39331",
    strip_prefix = "postgresql-{}-x86_64-unknown-linux-gnu".format(_PG_VERSION),
    url = "https://github.com/theseus-rs/postgresql-binaries/releases/download/{v}/postgresql-{v}-x86_64-unknown-linux-gnu.tar.gz".format(v = _PG_VERSION),
)

http_archive(
    name = "postgresql_linux_arm64",
    build_file_content = _PG_BUILD,
    sha256 = "d4fe7f1fd8762d837d4091438fb139321ea7cb11abce95f51616ae1434fffd77",
    strip_prefix = "postgresql-{}-aarch64-unknown-linux-gnu".format(_PG_VERSION),
    url = "https://github.com/theseus-rs/postgresql-binaries/releases/download/{v}/postgresql-{v}-aarch64-unknown-linux-gnu.tar.gz".format(v = _PG_VERSION),
)

http_archive(
    name = "postgresql_darwin_arm64",
    build_file_content = _PG_BUILD,
    sha256 = "770cb9985aa903a8207ec98a3dfe762bf40234486ee5950c3809ddf6b1c9f921",
    strip_prefix = "postgresql-{}-aarch64-apple-darwin".format(_PG_VERSION),
    url = "https://github.com/theseus-rs/postgresql-binaries/releases/download/{v}/postgresql-{v}-aarch64-apple-darwin.tar.gz".format(v = _PG_VERSION),
)

http_archive(
    name = "postgresql_darwin_amd64",
    build_file_content = _PG_BUILD,
    sha256 = "cff3bdaae703162b36c7622d5a30486df498ad72c2b0dc4a62173ec0d17df29a",
    strip_prefix = "postgresql-{}-x86_64-apple-darwin".format(_PG_VERSION),
    url = "https://github.com/theseus-rs/postgresql-binaries/releases/download/{v}/postgresql-{v}-x86_64-apple-darwin.tar.gz".format(v = _PG_VERSION),
)

