# Pin the Bazel version range so a developer who skipped Bazelisk (or has a stray
# system `bazel` on PATH) fails fast with a clear message instead of cryptic flag
# errors or silent local-vs-CI drift. `.bazelversion` (consumed by Bazelisk) pins
# the exact build (9.1.1); this is the floor/ceiling enforced by Bazel itself for
# ANY invocation. Bump the ceiling deliberately when moving to Bazel 10.
module(
    name = "vitruvian_core",
    bazel_compatibility = [
        ">=9.1.0",
        "<10.0.0",
    ],
)

# Currently bazel-lib is only load()ed when platforms is used.
bazel_dep(name = "bazel_lib", version = "3.1.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", repo_name = None)  # force a recent version that works with v3
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "apple_support", version = "2.2.0")
bazel_dep(name = "rules_swift", version = "3.6.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "build_bazel_rules_apple")

# Loads CcInfo from rules_cc (Bazel 9 removed the builtin). 2.6.0 moved the
# clippy aspect into the separate aspect_rules_lint_rust module, which we now
# take (see the Rust section) so clippy is wired again for any future rust_* —
# matching the kitchen-sink.
bazel_dep(name = "aspect_rules_lint", version = "2.7.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")

# Aggregates //:gazelle (+ python manifest) and //tools/format into //:tidy.
bazel_dep(name = "rules_multirun", version = "0.13.0")
bazel_dep(name = "bazel_env.bzl", version = "0.7.2")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2")

# We have to take a dependency on rules_python in order to set bootstrap=script
# for transitive dependencies, even if there are no Python rules used in this repo.
# See .bazelrc
bazel_dep(name = "rules_python", version = "1.8.3")

# Prebuilt Aspect gazelle binary, matching the kitchen-sink. vc ALREADY runs this
# exact binary for BUILD generation via @multitool//tools/gazelle (tools.lock.json
# pins aspect-gazelle); declaring it as an explicit module dep closes the
# divergence list. The //:gazelle runner is intentionally NOT rewired to this
# module's bundled binary (a different build) — BUILD output stays byte-identical.
bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.20")

# Bare gazelle stays for the go_deps extension (Go dependency resolution).
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "tar.bzl", version = "0.10.5")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")

#########################
# Go
bazel_dep(name = "rules_go", version = "0.61.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Download an SDK for the host OS & architecture as well as common remote execution
# platforms, using the version given from the `go.mod` file.
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//tools/lint:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

# Multi-module monorepo: a single go_deps.from_file(go_work=...) covers every
# module listed in //:go.work (root + ./homelab). Gazelle 0.47 rejects more than
# one go_deps.from_file tag per module, so we must NOT add a second
# from_file(go_mod=...) line per added module -- instead add the module to
# //:go.work and it is picked up here automatically.
go_deps.from_file(go_work = "//:go.work")

# All *direct* Go dependencies of the module have to be listed explicitly.
# Run 'bazel mod tidy' to update this
use_repo(go_deps, "com_github_charmbracelet_bubbles", "com_github_charmbracelet_bubbletea", "com_github_charmbracelet_huh", "com_github_charmbracelet_lipgloss", "com_github_google_uuid", "com_github_hashicorp_yamux", "com_github_joho_godotenv", "com_github_magefile_mage", "com_github_mark3labs_mcp_go", "com_github_pelletier_go_toml_v2", "com_github_spf13_cobra", "in_gopkg_yaml_v3", "org_golang_x_crypto", "org_golang_x_sync")

# Bazel 9: Ensure transitives don't depend on rules_nodejs prior to
# https://github.com/bazel-contrib/rules_nodejs/commit/1fc6b6b763c4f79994edc9edab10399f7446d8be
bazel_dep(name = "rules_nodejs", version = "6.7.4")

# 3.2.x is required for App Router support in @aspect_rules_js//contrib/nextjs
# (used by //tabula/web) and the exec-configured npm deps fix for js_image_layer.
bazel_dep(name = "aspect_rules_js", version = "3.2.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.11")

# SWC transpiler for ts_project (fast JS transpile; tsc still type-checks + emits .d.ts).
bazel_dep(name = "aspect_rules_swc", version = "2.7.2")

# JS test runner (//tabula unit tests).
bazel_dep(name = "aspect_rules_jest", version = "0.25.2")

#########################
# Hermetic integration/E2E test services (//tabula): rules_itest orchestrates
# Postgres + Redis + the Fastify API as health-checked test services; browsers
# for Playwright come from rules_playwright pinned to the lockfile's version.
bazel_dep(name = "rules_itest", version = "0.0.56")
bazel_dep(name = "rules_playwright", version = "0.5.3")

# Hermetic redis-server/redis-cli (cc_binary, pairs with rules_itest).
bazel_dep(name = "redis", version = "8.6.2")

# clang 15 (the Linux default toolchain) rejects redis's static _Atomic
# function-pointer NULL initializer; see the patch header for details.
single_version_override(
    module_name = "redis",
    patch_strip = 1,
    patches = ["//tools/testinfra:patches/redis-atomic-fnptr-clang15.patch"],
)

# Hermetic Playwright browsers, pinned by the vendored browsers.json matching
# the lockfile's playwright-core version (re-vendor on Playwright bumps).
# @playwright/test is pinned to 1.57.0: Playwright >= 1.58 serves chromium via
# Chrome-for-Testing CDN paths (builds/cft/<version>/...) that rules_playwright
# 0.5.x cannot construct; bump both together once the ruleset supports CfT.
playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    browsers_json = "//tools/testinfra:playwright-browsers-1.57.0.json",
)
use_repo(playwright, "playwright")

#########################
# JavaScript and pnpm package manager
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version_from_nvmrc = "//:.nvmrc")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    # Hermeticity: Prisma's lifecycle hooks download engine binaries from the
    # network (@prisma/engines postinstall) or auto-run `prisma generate`
    # (@prisma/client postinstall). //tabula uses the engine-free generator and
    # runs generate as a build action, so both hooks are disabled.
    lifecycle_hooks_exclude = [
        "@prisma/client",
        "@prisma/engines",
    ],
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version_from = "//:package.json")
use_repo(rules_ts_ext, "npm_typescript")

