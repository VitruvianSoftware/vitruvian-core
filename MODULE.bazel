# Go
bazel_dep(name = "rules_go", version = "0.61.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Download an SDK for the host OS & architecture as well as common remote execution
# platforms, using the version given from the `go.mod` file.
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(nogo = "//tools/lint:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

# Multi-module monorepo: a single go_deps.from_file(go_work=...) covers every
# module listed in //:go.work (root + ./homelab). Gazelle 0.47 rejects more than
# one go_deps.from_file tag per module, so we must NOT add a second
# from_file(go_mod=...) line per added module -- instead add the module to
# //:go.work and it is picked up here automatically.
go_deps.from_file(go_work = "//:go.work")

# go.mau.fi/whatsmeow (pulled in by mautrix-whatsapp for apps/desktop/courier):
# its .proto files import each other by bare paths ("waSyncAction/...proto",
# rooted at proto/), which gazelle cannot map to labels, so the generated
# go_proto_library deps point at nonexistent packages. The generated
# *.pb.go files are checked in, so skip proto generation and compile those.
go_deps.gazelle_override(
    directives = ["gazelle:proto disable"],
    path = "go.mau.fi/whatsmeow",
)

# go.mau.fi/util (pblite, used by mautrix-gmessages and mautrix-telegram): gazelle
# turns pblite.proto into a go_proto_library, but the checked-in pblite.pb.go
# already defines the same package and the generated one drops the extension
# (E_PbliteBinary) that deserialize.go uses. Skip proto generation and compile
# the checked-in file.
go_deps.gazelle_override(
    directives = ["gazelle:proto disable"],
    path = "go.mau.fi/util",
)

# go.mau.fi/webp (cgo libwebp, used by whatsmeow for stickers): gazelle files
# the vendored C sources/headers under embedsrcs, which the cgo action never
# sees, so the build fails with "'webp.h' file not found". The patch adds a
# hand-written BUILD.bazel that exposes them to cgo, and gazelle is told not
# to generate one over it.
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "go.mau.fi/webp",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//tools/go_deps:webp-cgo-headers.patch"],
    path = "go.mau.fi/webp",
)

# go.mau.fi/mautrix-signal (Courier's Signal bridge): pkg/libsignalgo links
# Signal's Rust library through cgo as a bare `-lsignal_ffi`, expecting a
# prebuilt libsignal_ffi.a on the linker search path. The patch drops that
# flag and adds //apps/desktop/courier/libsignal:signal_ffi (built from source) to the
# gazelle-generated go_library's cdeps instead; it also links libc++, not
# libstdc++, on darwin. go_repository applies patches after gazelle, so the
# patch edits the generated BUILD.bazel.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//tools/go_deps:mautrix-signal-libsignal-ffi.patch"],
    path = "go.mau.fi/mautrix-signal",
)

# github.com/mattn/go-sqlite3 (the cgo SQLite driver under Courier's engine and
# its bridges): Courier's search index needs FTS5 (with contentless_delete,
# SQLite 3.43+), which upstream compiles only under the sqlite_fts5 build tag.
# A repo-wide --@rules_go//go/config:tags would be lost by any build that
# doesn't read .bazelrc, so the patch adds -DSQLITE_ENABLE_FTS5 (and -lm, as
# upstream's tagged file does) to the gazelle-generated go_library instead.
# go_repository applies patches after gazelle, so the patch edits the
# generated BUILD.bazel. Tested by TestFTS5IsCompiledIn
# (apps/desktop/courier/engine/internal/sqlite).
go_deps.module_override(
    patch_strip = 1,
    patches = ["//tools/go_deps:go-sqlite3-fts5.patch"],
    path = "github.com/mattn/go-sqlite3",
)

# All *direct* Go dependencies of the module have to be listed explicitly.
# Run 'bazel mod tidy' to update this
use_repo(go_deps, "com_github_blang_semver", "com_github_charmbracelet_bubbles", "com_github_charmbracelet_bubbletea", "com_github_charmbracelet_huh", "com_github_charmbracelet_lipgloss", "com_github_google_uuid", "com_github_hashicorp_yamux", "com_github_joho_godotenv", "com_github_magefile_mage", "com_github_mark3labs_mcp_go", "com_github_mdp_qrterminal_v3", "com_github_modelcontextprotocol_go_sdk", "com_github_pelletier_go_toml_v2", "com_github_pulumi_pulumi_command_sdk", "com_github_pulumi_pulumi_gcp_sdk_v9", "com_github_pulumi_pulumi_random_sdk_v4", "com_github_pulumi_pulumi_sdk_v3", "com_github_rs_zerolog", "com_github_spf13_cobra", "com_github_stretchr_testify", "fi_mau_go_mautrix_gmessages", "fi_mau_go_mautrix_signal", "fi_mau_go_mautrix_slack", "fi_mau_go_mautrix_telegram", "fi_mau_go_mautrix_whatsapp", "fi_mau_go_util", "in_gopkg_yaml_v3", "net_maunium_go_mautrix", "org_golang_google_protobuf", "org_golang_x_crypto", "org_golang_x_image", "org_golang_x_sync", "org_golang_x_term", "org_golang_x_text")

