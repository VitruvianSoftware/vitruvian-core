# Android NDK, so an APK can be built for the ABIs a DEVICE uses rather than
# the ABI of whichever machine happened to build it.
#
# Without a cc toolchain registered for the Android platforms, Bazel cannot
# resolve `--android_platforms` at all -- it fails analysis on
# `@rules_cc//cc:current_cc_toolchain` -- so the ABI silently falls back to the
# build host. A Linux runner then publishes an x86_64-only APK that a phone
# rejects with INSTALL_FAILED_NO_MATCHING_ABIS, off a green build. The older
# `--fat_apk_cpu` is inert under platform-based toolchain resolution and does
# NOT work around this; it was tried and measured doing nothing (#2359).
#
# The NDK itself is fetched hermetically by tools/android_ndk below; this
# dependency supplies the toolchain rules, not the NDK.
bazel_dep(name = "rules_android_ndk", version = "0.1.5")

# Patched to let android_ndk_repository fetch a checksum-pinned NDK instead of
# resolving one from the machine. The patch carries its own rationale; rebase
# it when bumping the version above.
# TODO(upstream-ndk): this override exists only until upstream can fetch the
# NDK itself. Conditions and the last-checked state live in
# tools/android_ndk/extension.bzl.
single_version_override(
    module_name = "rules_android_ndk",
    patch_strip = 1,
    patches = ["//tools/android_ndk:hermetic_ndk.patch"],
    version = "0.1.5",
)

# Hermetic: tools/android_ndk fetches a checksum-pinned NDK and points
# rules_android_ndk at it, rather than using that module's own extension, which
# would resolve ANDROID_NDK_HOME from the machine. Same reasoning as
# @llvm_toolchain above -- a build should not change because a runner image
# shipped a different NDK.
android_ndk = use_extension("//tools/android_ndk:extension.bzl", "hermetic_android_ndk")
use_repo(android_ndk, "androidndk")

