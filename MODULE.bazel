# In the Maven support variation, the dependencies are conveniently listed here
# in the MODULE.bazel file.
#
# The androidx/Compose block belongs to //packages/design-system-android and
# //mobile/android/remote. Google Maven has to be listed explicitly: naming
# `repositories` at all replaces rules_jvm_external's Maven Central default,
# so Central is repeated here rather than inherited.
#
# After changing this list, re-pin the lock file:
#   bazel run @unpinned_maven//:pin
maven.install(
    artifacts = [
        # Compose: versions come from the BOM below, so they cannot drift apart
        # from each other. Hand-picking them is what made this set unresolvable
        # (collection, then collection-jvm, then lifecycle-runtime each
        # conflicted in turn).
        "androidx.compose.animation:animation",
        "androidx.compose.animation:animation-core",
        "androidx.compose.foundation:foundation",
        "androidx.compose.foundation:foundation-layout",
        "androidx.compose.runtime:runtime",
        "androidx.compose.ui:ui",
        "androidx.compose.ui:ui-graphics",
        "androidx.compose.ui:ui-text",
        "androidx.compose.ui:ui-tooling-preview",
        "androidx.compose.ui:ui-unit",
        # Outside the Compose BOM, so pinned explicitly and chosen to agree
        # with Compose 1.7.5's own transitive requirements.
        "androidx.activity:activity-compose:1.9.3",
        "androidx.annotation:annotation:1.9.1",
        "androidx.lifecycle:lifecycle-runtime:2.8.7",
        # Not used directly. androidx.collection sits outside the Compose BOM,
        # and the graph pulls in three incompatible opinions about it
        # (activity wants 1.0.0, an older collection-ktx hard-pins [1.2.0],
        # compose runtime-android wants collection-jvm 1.4.4). Pinning the
        # pair at 1.4.4 -- what Compose 1.7.5 actually asks for -- settles it.
        "androidx.collection:collection:1.4.4",
        "androidx.collection:collection-ktx:1.4.4",
        # Not used directly, and it must be stated or the app crashes on
        # launch. activity, compose-ui and lifecycle-runtime each pull
        # androidx.profileinstaller, which pulls androidx.concurrent:
        # concurrent-futures, which depends on listenablefuture -- and the
        # version the graph resolves is the placeholder
        # 9999.0-empty-to-avoid-conflict-with-guava, an intentionally EMPTY
        # jar that exists only so Maven can dedupe it against real guava.
        # AbstractResolvableFuture then ships without the interface it
        # implements, and ProfileInstaller's startup initializer dies with
        # NoClassDefFoundError on a background thread, killing the process
        # before the first frame. 1.0 is the real ~5 KB single-interface jar;
        # version_conflict_policy = "pinned" is what makes it win over the
        # transitive 9999.0. Guava proper would also supply the class, at
        # roughly 3 MB for one interface.
        "com.google.guava:listenablefuture:1.0",
        # Foldables: WindowInfoTracker/FoldingFeature and WindowSizeClass.
        "androidx.window:window:1.3.0",
        "androidx.window:window-core:1.3.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.9.0",
        # The Compose compiler plugin ships with the Kotlin release from 2.0
        # on, and is compiled against that release's compiler internals, so it
        # MUST equal rules_kotlin's Kotlin version (2.3.20 for rules_kotlin
        # 2.3.20 -- KOTLIN_CURRENT_COMPILER_RELEASE). At 2.0.21 against a
        # 2.3.20 compiler the build dies with
        # NoSuchMethodError: FunctionTypeKind.<init> in ComposableFunction.
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.3.20",
    ],
    # 2024.11.00 is the BOM for Compose 1.7.5.
    boms = ["androidx.compose:compose-bom:2024.11.00"],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    # The versions listed above win over transitive constraints, so the version
    # actually built is the version this file says. androidx needs this: the
    # graph carries several conflicting hard pins that coursier cannot
    # otherwise choose between.
    version_conflict_policy = "pinned",
)
use_repo(
    maven,
    "maven",
    "unpinned_maven",
)

