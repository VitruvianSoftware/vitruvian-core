# Pin the Bazel version range so a developer who skipped Bazelisk (or has a stray
# system `bazel` on PATH) fails fast with a clear message instead of cryptic flag
# errors or silent local-vs-CI drift. `.bazelversion` (consumed by Bazelisk) pins
# the exact build (9.3.0); this is the floor/ceiling enforced by Bazel itself for
# ANY invocation. Bump the ceiling deliberately when moving to Bazel 10.
module(
    name = "vitruvian_core",
    bazel_compatibility = [
        ">=9.1.0",
        "<10.0.0",
    ],
)

# Currently bazel-lib is only load()ed when platforms is used.
bazel_dep(name = "bazel_lib", version = "3.1.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", repo_name = None)  # force a recent version that works with v3
bazel_dep(name = "platforms", version = "1.1.0")

# Hermetic jq for sh_tests: the remote-exec image (rbe-ubuntu22-04) has none.
bazel_dep(name = "jq.bzl", version = "0.7.0")

jq_toolchains = use_extension("@jq.bzl//jq:extensions.bzl", "toolchains")
use_repo(jq_toolchains, "jq_toolchains")

bazel_dep(name = "apple_support", version = "2.8.4")
bazel_dep(name = "rules_swift", version = "4.1.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_apple", version = "5.1.0", repo_name = "build_bazel_rules_apple")

# Loads CcInfo from rules_cc (Bazel 9 removed the builtin). 2.6.0 moved the
# clippy aspect out of lint/ into the separate aspect_rules_lint_rust module;
# rather than take that module we dropped clippy from tools/lint/linters.bzl
# (nothing to lint -- Cargo members=[], zero .rs files), so 2.7.1 is a clean bump.
bazel_dep(name = "aspect_rules_lint", version = "2.7.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")

# Aggregates //:gazelle (+ python manifest) and //tools/format into //:tidy.
bazel_dep(name = "rules_multirun", version = "0.13.0")
bazel_dep(name = "bazel_env.bzl", version = "0.7.2")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2")

# We have to take a dependency on rules_python in order to set bootstrap=script
# for transitive dependencies, even if there are no Python rules used in this repo.
# See .bazelrc
bazel_dep(name = "rules_python", version = "1.8.3")

# Prebuilt Aspect gazelle binary, matching the kitchen-sink. vc ALREADY runs this
# exact binary for BUILD generation via @multitool//tools/gazelle (tools.lock.json
# pins aspect-gazelle); declaring it as an explicit module dep closes the
# divergence list. The //:gazelle runner is intentionally NOT rewired to this
# module's bundled binary (a different build) — BUILD output stays byte-identical.
bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.20")

# Bare gazelle stays for the go_deps extension (Go dependency resolution).
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "tar.bzl", version = "0.10.5")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")

