# Hermetic C++ toolchain, to relieve the dependency on a locally installed CC etc.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    # NB: llvm doesn't release for all platforms on every patch release
    llvm_versions = {
        "": "15.0.6",
        # macOS arm64: LLVM 15's bundled `ld64.lld` cannot parse the text-based
        # dylib (.tbd) stubs shipped by recent macOS SDKs (e.g. macOS 15/26),
        # so linking rules_rust's bootstrap `process_wrapper` (and any other
        # darwin link that pulls in libSystem) fails with errors like
        # "libSystem.tbd ... is incompatible with arm64 (macOS)" and a cascade
        # of undefined POSIX symbols (_mmap, _pthread_*, ...). LLVM 17's
        # `ld64.lld` understands these stubs. Linux stays on 15.0.6 (unaffected).
        # NB: toolchains_llvm 1.6.0 only ships LLVM 16/17 for arm64-apple-darwin;
        # x86_64-apple-darwin has no build newer than 15.0.7, so Intel macOS keeps
        # 15.0.7 (its newest available; same value the template already used).
        "darwin-aarch64": "17.0.6",
        "darwin-x86_64": "15.0.7",
    },
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# Apple's CC toolchain provides the `objc-executable` action_config that
# rules_apple's macos_application needs to link the .app. We make the repo
# available here but deliberately do NOT register it globally: on macOS it would
# shadow @llvm_toolchain for ALL C++ (the host platform is constraint-identical to
# the apple `darwin_*` platform rules_apple transitions to), silently making plain
# C++/Rust/cgo builds non-hermetic. Instead the macOS .app build opts in via
# `--config=macos-app` (see .bazelrc), so the hermetic LLVM toolchain stays the
# default everywhere else.
apple_cc_configure = use_extension("@apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_cc_configure, "local_config_apple_cc_toolchains")

register_toolchains("@llvm_toolchain//:all")

