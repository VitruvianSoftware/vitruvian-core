# Root registrations are considered before rules_rust's own
# register_toolchains("@rust_toolchains//:all"), whose 1.75.0 toolchains match
# any target; these two match only under the libsignal flag.
register_toolchains(
    "@rust_toolchains//:rust_libsignal_darwin_aarch64__aarch64-apple-darwin__stable",
    "@rust_toolchains//:rust_libsignal_darwin_aarch64__x86_64-apple-darwin__stable",
)

# libsignal's crate graph. apps/desktop/courier/libsignal/Cargo.toml is a one-package
# workspace that depends on libsignal's crates at the pinned commit, so rules_rs
# generates every one of them (build scripts included) like any crates.io crate.
crate.from_cargo(
    name = "libsignal_crates",
    cargo_lock = "//apps/desktop/courier/libsignal:Cargo.lock",
    cargo_toml = "//apps/desktop/courier/libsignal:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
    ],
)

# rules_rs finds a git crate inside its repo through the workspace's
# [workspace.dependencies] table; these four are not listed there, so say where
# they live.
[
    crate.annotation(
        crate = name,
        repositories = ["libsignal_crates"],
        strip_prefix = path,
    )
    for name, path in {
        "libsignal-ffi": "rust/bridge/ffi",
        "libsignal-ffi-impl": "rust/bridge/ffi/impl",
        "libsignal-message-backup-macros": "rust/message-backup/macros",
        "libsignal-net-infra": "rust/net/infra",
    }.items()
]

# boring-sys (Signal's BoringSSL fork) normally runs CMake on a git submodule
# that the GitHub source archive does not contain. Instead it is handed a
# BoringSSL that Bazel built itself (@signal_boringssl, below, with the same
# post-quantum patch boring-sys would apply), laid out as BORING_BSSL_PATH
# expects. Its bindgen step loads libclang from the hermetic LLVM toolchain
# and reads system headers from _MACOS_SDK, the SDK llvm.sysroot pins.
# ASSUME_PATCHED only records that @signal_boringssl carries the patch; with
# BORING_BSSL_PATH set, boring-sys skips patching anyway.
crate.annotation(
    build_script_data = ["@@//apps/desktop/courier/libsignal:boringssl_prefix"],
    build_script_env = {
        "BORING_BSSL_ASSUME_PATCHED": "1",
        "BORING_BSSL_PATH": "$(execpath @@//apps/desktop/courier/libsignal:boringssl_prefix)",
        "BORING_BSSL_SYSROOT": _MACOS_SDK,
        "LIBCLANG_PATH": "$(execpath @@//apps/desktop/courier/libsignal:libclang)",
    },
    build_script_tools = [
        "@@//apps/desktop/courier/libsignal:clang_headers",
        "@@//apps/desktop/courier/libsignal:libclang",
    ],
    crate = "boring-sys",
    repositories = ["libsignal_crates"],
)

# libsignal's protobuf build scripts run protoc: prost-build from $PROTOC,
# protobuf-codegen from $PATH. //apps/desktop/courier/libsignal:protoc is the protobuf
# module's protoc plus its well-known types.
[
    crate.annotation(
        build_script_env = {
            "PATH": "$(execpath @@//apps/desktop/courier/libsignal:protoc)/bin:/usr/bin:/bin",
            "PROTOC": "$(execpath @@//apps/desktop/courier/libsignal:protoc)/bin/protoc",
        },
        build_script_tools = ["@@//apps/desktop/courier/libsignal:protoc"],
        crate = name,
        repositories = ["libsignal_crates"],
    )
    for name in [
        "attest",
        "libsignal-account-keys",
        "libsignal-keytrans",
        "libsignal-message-backup",
        "libsignal-net",
        "libsignal-net-grpc",
        "libsignal-protocol",
        "libsignal-svrb",
        "spqr",
        "usernames",
    ]
]

# curve25519-dalek's build script picks its SIMD backend on x86_64 and sets a
# custom cfg (curve25519_dalek_backend) that its Cargo.toml then keys the
# curve25519-dalek-derive dependency on. rules_rs evaluates target cfgs before
# any build script runs, so it drops that dependency and the x86_64 build fails
# with "cannot find curve25519_dalek_derive". Add it back; on arm64 it is an
# unused proc macro.
crate.annotation(
    crate = "curve25519-dalek",
    repositories = ["libsignal_crates"],
    deps = ["@libsignal_crates//:curve25519-dalek-derive-0.1.1"],
)

# ring's build script compiles C with cc-rs, which runs the compiler from the
# build script's working directory. rules_rust hands it the LLVM toolchain's
# CFLAGS, and some of those name files relative to the execroot
# (-imacros external/.../redacted_dates.h), so they do not resolve there.
# cc-rs prefers CC_<target> over CC: point it at a wrapper that cds to the
# execroot ($${pwd}, filled in by rules_rust) and then runs the real $CC.
crate.annotation(
    build_script_env = {
        "CC_aarch64_apple_darwin": "$(execpath @@//apps/desktop/courier/libsignal:cc_in_execroot)",
        "CC_x86_64_apple_darwin": "$(execpath @@//apps/desktop/courier/libsignal:cc_in_execroot)",
        "COURIER_BAZEL_EXECROOT": "$${pwd}",
    },
    build_script_tools = ["@@//apps/desktop/courier/libsignal:cc_in_execroot"],
    crate = "ring",
    repositories = ["libsignal_crates"],
)
use_repo(crate, "libsignal_crates")

